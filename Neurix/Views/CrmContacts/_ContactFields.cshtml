@model Neurix.Models.CrmContactFormViewModel
@using Neurix.DAL.Enums

@{
    const string InputCls = "w-full rounded-xl bg-background/60 border border-border px-4 h-11 text-sm outline-none transition-all duration-300 focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]";
    const string LabelCls = "block text-sm font-medium mb-2";
    const string ErrCls = "text-xs text-rose-500/80 mt-1.5 block font-medium";
}

<div asp-validation-summary="ModelOnly" class="mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-500 empty:hidden"></div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <div>
        <label asp-for="FirstName" class="@LabelCls"></label>
        <input asp-for="FirstName" class="@InputCls" placeholder='@L["Jane"]' />
        <span asp-validation-for="FirstName" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="LastName" class="@LabelCls"></label>
        <input asp-for="LastName" class="@InputCls" placeholder='@L["Doe"]' />
        <span asp-validation-for="LastName" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="JobTitle" class="@LabelCls"></label>
        <input asp-for="JobTitle" class="@InputCls" placeholder='@L["Head of Operations"]' />
        <span asp-validation-for="JobTitle" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="CompanyId" class="@LabelCls"></label>
        <select asp-for="CompanyId" asp-items="Model.CompanyOptions" class="@InputCls">
            <option value="">@L["— No company —"]</option>
        </select>
        <span asp-validation-for="CompanyId" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="Email" class="@LabelCls"></label>
        <input asp-for="Email" type="email" class="@InputCls" placeholder="jane@acme.com" />
        <span asp-validation-for="Email" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="Phone" class="@LabelCls"></label>
        <input asp-for="Phone" class="@InputCls" placeholder="+20 100 000 0000" />
        <span asp-validation-for="Phone" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="Status" class="@LabelCls"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<RecordStatus>()" class="@InputCls"></select>
        <span asp-validation-for="Status" class="@ErrCls"></span>
    </div>

    <div class="md:col-span-2">
        <label asp-for="Notes" class="@LabelCls"></label>
        <textarea asp-for="Notes" rows="4" placeholder='@L["Anything worth remembering about this person"]'
                  class="w-full rounded-xl bg-background/60 border border-border px-4 py-3 text-sm outline-none transition-all duration-300 resize-y focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]"></textarea>
        <span asp-validation-for="Notes" class="@ErrCls"></span>
    </div>
</div>
