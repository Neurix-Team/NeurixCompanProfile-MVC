@model Neurix.Models.CrmContactDetailsViewModel

<div class="max-w-5xl">

    <a asp-action="Index" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i>
        @L["Back to contacts"]
    </a>

    @* ── Header ── *@
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-2">
                <h2 class="font-display text-xl font-bold tracking-tight truncate">@Model.FullName</h2>
                <partial name="_CrmStatusBadge" model="Model.Status" />
            </div>
            <p class="text-sm text-muted-foreground">
                @(Model.JobTitle ?? "No job title set")
                @if (Model.HasCompany)
                {
                    <span class="mx-1.5 text-border">·</span>
                    <a asp-controller="CrmCompanies" asp-action="Details" asp-route-id="@Model.CompanyId" class="hover:text-cyan transition-colors">
                        @Model.CompanyName
                    </a>
                }
            </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            @* Pre-fills the deal form. Company is only passed when this contact has
               one — otherwise the form's required Company field is picked manually. *@
            <a asp-controller="CrmDeals" asp-action="Create"
               asp-route-companyId="@(Model.HasCompany ? Model.CompanyId : null)"
               asp-route-contactId="@Model.Id"
               class="inline-flex items-center gap-1.5 rounded-[16px] px-4 h-10 text-sm font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:shadow-[0_0_30px_hsl(var(--cyan)/0.5)] transition-all duration-300">
                <i data-lucide="handshake" class="w-4 h-4"></i>
                @L["New deal"]
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-flex items-center gap-1.5 rounded-xl border border-border px-4 h-10 text-sm font-medium hover:bg-muted transition-colors">
                <i data-lucide="pencil" class="w-4 h-4"></i>
                @L["Edit"]
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('@L["Delete this contact?"]');">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-rose-500/30 px-4 h-10 text-sm font-medium text-rose-500 hover:bg-rose-500/10 transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    @L["Delete"]
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* ── Details card ── *@
        <div class="lg:col-span-2 rounded-2xl border border-border bg-card/60 p-6">
            <h3 class="font-display text-sm font-semibold mb-5">@L["Contact details"]</h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Email"]</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <a href="mailto:@Model.Email" class="text-cyan hover:underline break-all">@Model.Email</a>
                        }
                        else
                        {
                            <span class="text-muted-foreground">—</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Phone"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Notes"]</dt>
                    <dd class="whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
                </div>
            </dl>

            <div class="mt-6 pt-5 border-t border-border text-xs text-muted-foreground">
                Created @Model.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC
                @if (Model.UpdatedAtUtc.HasValue)
                {
                    <span class="mx-1.5 text-border">·</span>
                    <text>Updated @Model.UpdatedAtUtc.Value.ToString("dd MMM yyyy, HH:mm") UTC</text>
                }
            </div>
        </div>

        @* ── Company card ── *@
        <div class="rounded-2xl border border-border bg-card/60 p-6">
            <h3 class="font-display text-sm font-semibold mb-5">@L["Company"]</h3>

            @if (!Model.HasCompany)
            {
                <p class="text-sm text-muted-foreground">
                    @L["Not linked to a company."]
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="text-cyan hover:underline">@L["Link one"]</a>.
                </p>
            }
            else
            {
                <a asp-controller="CrmCompanies" asp-action="Details" asp-route-id="@Model.CompanyId" class="block group">
                    <span class="text-sm font-medium group-hover:text-cyan transition-colors">@Model.CompanyName</span>
                    <span class="block text-xs text-muted-foreground mt-0.5">@(Model.CompanyIndustry ?? "No industry set")</span>
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone) || !string.IsNullOrWhiteSpace(Model.CompanyEmail))
                {
                    <div class="mt-4 pt-4 border-t border-border text-xs text-muted-foreground space-y-1.5">
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                        {
                            <p class="break-all">@Model.CompanyEmail</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                        {
                            <p>@Model.CompanyPhone</p>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
