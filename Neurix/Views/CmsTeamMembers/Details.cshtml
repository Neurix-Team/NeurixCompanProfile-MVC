@model Neurix.Models.CmsTeamMemberDetailsViewModel
@{
    ViewData["Title"] = $"Team Member — {Model.Member.NameEn}";
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@Model.Member.NameEn</h1>
            <p class="text-sm text-muted-foreground" dir="rtl">@Model.Member.NameAr</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Member.Id" class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors">
                <i data-lucide="edit-3" class="w-4 h-4"></i> @L["Edit"]
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back to List"]
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
        <div class="flex items-center gap-5">
            @if (!string.IsNullOrWhiteSpace(Model.Member.PhotoPath))
            {
                <img src="@Model.Member.PhotoPath" alt="@Model.Member.NameEn" class="w-20 h-20 rounded-2xl object-cover border border-border" />
            }
            else
            {
                <div class="w-20 h-20 rounded-2xl bg-cyan/10 border border-cyan/20 flex items-center justify-center text-cyan text-xl font-bold">
                    @Model.Member.NameEn.Substring(0, Math.Min(2, Model.Member.NameEn.Length)).ToUpper()
                </div>
            }

            <div class="space-y-1">
                <div class="flex items-center gap-3">
                    <h2 class="text-lg font-bold text-foreground">@Model.Member.NameEn</h2>
                    <partial name="_CmsStatusBadge" model="Model.Member.IsPublished" />
                </div>
                <p class="text-sm text-cyan font-medium">@Model.Member.TitleEn</p>
                <p class="text-xs text-muted-foreground" dir="rtl">@Model.Member.TitleAr</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border">
            <div class="space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["English Bio"]</h4>
                <p class="text-sm text-foreground leading-relaxed">@(Model.Member.BioEn ?? "No bio provided.")</p>
            </div>

            <div class="space-y-2" dir="rtl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">السيرة الذاتية (عربي)</h4>
                <p class="text-sm text-foreground leading-relaxed">@(Model.Member.BioAr ?? "لا توجد سيرة ذاتية.")</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-border text-xs text-muted-foreground">
            <div>
                <span class="font-medium text-foreground">@L["Brand Profile:"]</span> @Model.Member.CompanyNameEn
            </div>
            <div>
                <span class="font-medium text-foreground">@L["Email:"]</span> @(Model.Member.Email ?? "N/A")
            </div>
            <div>
                <span class="font-medium text-foreground">@L["LinkedIn:"]</span> @(Model.Member.LinkedInUrl ?? "N/A")
            </div>
        </div>
    </div>

</div>
