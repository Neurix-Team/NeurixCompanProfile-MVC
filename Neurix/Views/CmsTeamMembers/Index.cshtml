@model Neurix.Models.CmsTeamMemberListViewModel
@{
    ViewData["Title"] = "Team Members";
    Layout = "_CmsLayout";
}

<div class="space-y-6">

    @* Header *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@L["Team Members"]</h1>
            <p class="text-sm text-muted-foreground">@L["Manage leadership, researchers, and core contributors across brands."]</p>
        </div>

        <div class="flex items-center gap-3">
            @if (Model.Companies.Count > 1)
            {
                <form method="get" class="flex items-center gap-2">
                    <select name="companyId" onchange="this.form.submit()"
                            class="rounded-xl border border-border bg-card px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none">
                        <option value="">@L["All Brands"]</option>
                        @foreach (var c in Model.Companies)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.SelectedCompanyId)">@c.NameEn</option>
                        }
                    </select>
                </form>
            }

            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors shadow-sm">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add Team Member"]
            </a>
        </div>
    </div>

    @if (Model.TeamMembers.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-border p-12 text-center text-muted-foreground space-y-3">
            <i data-lucide="users" class="w-10 h-10 mx-auto text-muted-foreground/50"></i>
            <p class="text-sm">@L["No team members found."]</p>
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId" class="inline-flex items-center gap-1.5 text-xs text-cyan hover:underline">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> @L["Add the first team member"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var m in Model.TeamMembers)
            {
                <div class="rounded-2xl border border-border bg-card p-5 shadow-sm hover:border-cyan/40 transition-all flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(m.PhotoPath))
                                {
                                    <img src="@m.PhotoPath" alt="@m.NameEn" class="w-12 h-12 rounded-full object-cover border border-border" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-cyan/10 border border-cyan/20 flex items-center justify-center text-cyan font-bold">
                                        @m.NameEn.Substring(0, Math.Min(2, m.NameEn.Length)).ToUpper()
                                    </div>
                                }
                                <div>
                                    <h3 class="text-sm font-semibold text-foreground">@m.NameEn</h3>
                                    <p class="text-xs text-muted-foreground" dir="rtl">@m.NameAr</p>
                                    <span class="inline-block mt-1 text-[11px] font-medium text-cyan bg-cyan/10 px-2 py-0.5 rounded-full">
                                        @m.TitleEn
                                    </span>
                                </div>
                            </div>

                            <partial name="_CmsStatusBadge" model="m.IsPublished" />
                        </div>

                        <div class="text-xs text-muted-foreground space-y-1">
                            @if (!string.IsNullOrWhiteSpace(m.Email))
                            {
                                <div class="flex items-center gap-1.5">
                                    <i data-lucide="mail" class="w-3.5 h-3.5 text-muted-foreground"></i>
                                    <span>@m.Email</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.LinkedInUrl))
                            {
                                <div class="flex items-center gap-1.5">
                                    <partial name="_SocialIcon" model="@("linkedin")"
                                             view-data='@(new ViewDataDictionary(ViewData) { ["IconClass"] = "w-3.5 h-3.5 text-cyan" })' />
                                    <a href="@m.LinkedInUrl" target="_blank" class="hover:underline truncate max-w-[200px]">@m.LinkedInUrl</a>
                                </div>
                            }
                            <div class="text-[11px] text-muted-foreground/70">
                                @L["Brand:"] <span class="font-medium text-foreground">@m.CompanyNameEn</span> | Order: @m.DisplayOrder
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-2 pt-4 mt-4 border-t border-border">
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@m.Id"
                               class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground hover:text-foreground">
                                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> @L["Edit"]
                            </a>
                            <a asp-action="Details" asp-route-id="@m.Id"
                               class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground hover:text-foreground">
                                <i data-lucide="eye" class="w-3.5 h-3.5"></i> @L["View"]
                            </a>
                        </div>

                        <div class="flex items-center gap-2">
                            <form asp-action="TogglePublish" asp-route-id="@m.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isPublished" value="@(!m.IsPublished)" />
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="text-xs text-muted-foreground hover:text-foreground" title='@L["Toggle Publish"]'>
                                    <i data-lucide="@(m.IsPublished ? "eye-off" : "check-circle")" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('@L["Are you sure you want to delete this team member?"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="text-xs text-rose-500 hover:text-rose-400" title='@L["Delete Member"]'>
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
