@model Neurix.Models.CmsProjectDetailsViewModel
@{
    ViewData["Title"] = $"{L["Project Details"]} — {Model.Project.TitleEn}";
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@Model.Project.TitleEn</h1>
            <p class="text-sm text-muted-foreground" dir="rtl">@Model.Project.TitleAr</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors">
                <i data-lucide="edit-3" class="w-4 h-4"></i> @L["Edit"]
            </a>
            <a href="/portfolio/@Model.Project.Slug" target="_blank" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="external-link" class="w-4 h-4"></i> @L["Public View"]
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back"]
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
        <div class="flex flex-wrap items-center gap-3 text-xs">
            <partial name="_CmsStatusBadge" model="Model.Project.IsPublished" />
            @if (Model.Project.IsFeatured)
            {
                <span class="inline-flex items-center rounded-lg bg-amber-500/10 px-2 py-0.5 font-medium text-amber-500">@L["Featured"]</span>
            }
            <span class="inline-flex items-center rounded-lg bg-cyan/10 px-2.5 py-0.5 font-medium text-cyan">@(Model.Project.Category ?? "General")</span>
            <span class="text-muted-foreground">@L["Client:"] @(Model.Project.ClientName ?? "Neurix Ecosystem")</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border">
            <div class="space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["English Overview"]</h4>
                <p class="text-sm text-foreground leading-relaxed">@Model.Project.SummaryEn</p>
            </div>
            <div class="space-y-2" dir="rtl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["Arabic Overview"]</h4>
                <p class="text-sm text-foreground leading-relaxed">@Model.Project.SummaryAr</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Project.TechnologiesUsed))
        {
            <div class="pt-4 border-t border-border space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["Technologies & Stack"]</h4>
                <div class="flex flex-wrap gap-2">
                    @foreach (var tech in Model.Project.TechnologiesUsed.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-medium text-foreground">@tech.Trim()</span>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Project.DescriptionEn) || !string.IsNullOrWhiteSpace(Model.Project.DescriptionAr))
        {
            <div class="pt-4 border-t border-border space-y-4">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["Full Case Study"]</h4>
                <div class="p-4 rounded-xl bg-background/50 border border-border text-xs leading-relaxed whitespace-pre-wrap">
                    @Model.Project.DescriptionEn
                </div>
            </div>
        }
    </div>

</div>
