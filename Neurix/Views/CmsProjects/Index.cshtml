@model Neurix.Models.CmsProjectListViewModel
@{
    ViewData["Title"] = L["Projects & Case Studies"];
    Layout = "_CmsLayout";
}

<div class="space-y-6">

    @* Header *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@L["Projects & Case Studies"]</h1>
            <p class="text-sm text-muted-foreground">@L["Manage portfolio initiatives, research prototypes, and client deployments."]</p>
        </div>

        <div class="flex items-center gap-3">
            @if (Model.Companies.Count > 1)
            {
                <form method="get" class="flex items-center gap-2">
                    <select name="companyId" onchange="this.form.submit()"
                            class="rounded-xl border border-border bg-card px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none">
                        <option value="">@L["All Brands"]</option>
                        @foreach (var c in Model.Companies)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.SelectedCompanyId)">@(CmsLanguage.Current.IsRightToLeft && !string.IsNullOrWhiteSpace(c.NameAr) ? c.NameAr : c.NameEn)</option>
                        }
                    </select>
                </form>
            }

            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors shadow-sm">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add Project"]
            </a>
        </div>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-border p-12 text-center text-muted-foreground space-y-3">
            <i data-lucide="cpu" class="w-10 h-10 mx-auto text-muted-foreground/50"></i>
            <p class="text-sm">@L["No projects added yet."]</p>
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId" class="inline-flex items-center gap-1.5 text-xs text-cyan hover:underline">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> @L["Add your first project"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var p in Model.Projects)
            {
                <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-sm hover:border-cyan/40 transition-all flex flex-col justify-between">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(p.CoverImagePath))
                        {
                            <div class="h-40 bg-muted overflow-hidden">
                                <img src="@p.CoverImagePath" alt="@(CmsLanguage.Current.IsRightToLeft && !string.IsNullOrWhiteSpace(p.TitleAr) ? p.TitleAr : p.TitleEn)" class="w-full h-full object-cover" />
                            </div>
                        }
                        else
                        {
                            <div class="h-32 bg-cyan/5 border-b border-border flex items-center justify-center text-cyan">
                                <i data-lucide="cpu" class="w-10 h-10 opacity-40"></i>
                            </div>
                        }

                        <div class="p-5 space-y-3">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h3 class="text-sm font-semibold text-foreground">@(CmsLanguage.Current.IsRightToLeft && !string.IsNullOrWhiteSpace(p.TitleAr) ? p.TitleAr : p.TitleEn)</h3>
                                    <p class="text-[11px] text-muted-foreground font-mono">/portfolio/@p.Slug</p>
                                </div>
                                <div class="flex flex-col items-end gap-1">
                                    <partial name="_CmsStatusBadge" model="p.IsPublished" />
                                    @if (p.IsFeatured)
                                    {
                                        <span class="text-[10px] font-medium text-amber-500 bg-amber-500/10 px-1.5 py-0.5 rounded">@L["Featured"]</span>
                                    }
                                </div>
                            </div>

                            <p class="text-xs text-muted-foreground line-clamp-2">
                                @(CmsLanguage.Current.IsRightToLeft && !string.IsNullOrWhiteSpace(p.SummaryAr) ? p.SummaryAr : (p.SummaryEn ?? L["No summary provided."]))
                            </p>

                            @if (!string.IsNullOrWhiteSpace(p.TechnologiesUsed))
                            {
                                <div class="flex flex-wrap gap-1 pt-1">
                                    @foreach (var tech in p.TechnologiesUsed.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(3))
                                    {
                                        <span class="text-[10px] bg-muted text-muted-foreground px-2 py-0.5 rounded">@tech.Trim()</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-2 p-5 pt-0">
                        <div class="flex items-center gap-3">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="text-xs font-medium text-muted-foreground hover:text-foreground">@L["Edit"]</a>
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-xs font-medium text-muted-foreground hover:text-foreground">@L["View"]</a>
                        </div>
                        <div class="flex items-center gap-2">
                            <form asp-action="TogglePublish" asp-route-id="@p.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isPublished" value="@(!p.IsPublished)" />
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="text-muted-foreground hover:text-foreground">
                                    <i data-lucide="@(p.IsPublished ? "eye-off" : "check-circle")" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('@L["Are you sure you want to delete this project?"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="text-rose-500 hover:text-rose-400">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
