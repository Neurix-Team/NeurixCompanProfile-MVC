@model Neurix.Models.CmsBlogPostDetailsViewModel
@{
    ViewData["Title"] = $"Article — {Model.Post.TitleEn}";
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@Model.Post.TitleEn</h1>
            <p class="text-sm text-muted-foreground" dir="rtl">@Model.Post.TitleAr</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Post.Id" class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors">
                <i data-lucide="edit-3" class="w-4 h-4"></i> @L["Edit"]
            </a>
            <a href="/insights/@Model.Post.Slug" target="_blank" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="external-link" class="w-4 h-4"></i> @L["Public View"]
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back"]
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
        <div class="flex flex-wrap items-center gap-3 text-xs">
            <partial name="_CmsStatusBadge" model="Model.Post.IsPublished" />
            @if (Model.Post.IsFeatured)
            {
                <span class="inline-flex items-center rounded-lg bg-amber-500/10 px-2 py-0.5 font-medium text-amber-500">@L["Featured"]</span>
            }
            <span class="inline-flex items-center rounded-lg bg-cyan/10 px-2.5 py-0.5 font-medium text-cyan">@(Model.Post.Category ?? "General")</span>
            <span class="text-muted-foreground">@Model.Post.ReadTimeMinutes min read</span>
            <span class="text-muted-foreground">Published: @(Model.Post.PublishedAtUtc?.ToString("MMM dd, yyyy") ?? "Unpublished")</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border">
            <div class="space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["English Excerpt"]</h4>
                <p class="text-sm text-foreground leading-relaxed">@Model.Post.SummaryEn</p>
            </div>
            <div class="space-y-2" dir="rtl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">الملخص بالعربية</h4>
                <p class="text-sm text-foreground leading-relaxed">@Model.Post.SummaryAr</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Post.BodyEn) || !string.IsNullOrWhiteSpace(Model.Post.BodyAr))
        {
            <div class="pt-4 border-t border-border space-y-4">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["Body Content Preview"]</h4>
                <div class="p-4 rounded-xl bg-background/50 border border-border text-xs font-mono whitespace-pre-wrap max-h-96 overflow-y-auto">
                    @Model.Post.BodyEn
                </div>
            </div>
        }
    </div>

</div>
