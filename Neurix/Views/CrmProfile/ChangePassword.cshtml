@model Neurix.Models.CrmChangePasswordFormViewModel

@{
    ViewData["Title"] = "Change password";
}

<div class="max-w-lg mx-auto space-y-6">

    <div class="bg-card/60 backdrop-blur-xl border border-border rounded-3xl p-8 shadow-sm">
        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-cyan/10 flex items-center justify-center text-cyan shrink-0">
                <i data-lucide="key-round" class="w-6 h-6"></i>
            </div>
            <div class="min-w-0">
                <h1 class="font-display text-xl font-semibold tracking-tight">@L["Change password"]</h1>
            </div>
        </div>

        <form asp-controller="CrmProfile" asp-action="ChangePassword" method="post" class="space-y-4">

            <div asp-validation-summary="ModelOnly"
                 class="rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-500 empty:hidden"></div>

            <div>
                <label asp-for="CurrentPassword" class="block text-sm font-medium mb-2"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password"
                       class="w-full rounded-xl bg-background/60 border border-border px-4 h-12 text-sm outline-none transition-all duration-300 focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]" />
                <span asp-validation-for="CurrentPassword" class="text-xs text-rose-500/80 mt-1.5 block font-medium"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-sm font-medium mb-2"></label>
                <input asp-for="NewPassword" autocomplete="new-password"
                       class="w-full rounded-xl bg-background/60 border border-border px-4 h-12 text-sm outline-none transition-all duration-300 focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]" />
                <span asp-validation-for="NewPassword" class="text-xs text-rose-500/80 mt-1.5 block font-medium"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium mb-2"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password"
                       class="w-full rounded-xl bg-background/60 border border-border px-4 h-12 text-sm outline-none transition-all duration-300 focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500/80 mt-1.5 block font-medium"></span>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-[16px] px-6 py-3 text-sm font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:shadow-[0_0_36px_hsl(var(--cyan)/0.55)] transition-all duration-300">
                    @L["Save"]
                </button>
                <a asp-controller="CrmProfile" asp-action="Index"
                   class="inline-flex items-center gap-2 rounded-[16px] px-6 py-3 text-sm font-medium border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                    @L["Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
