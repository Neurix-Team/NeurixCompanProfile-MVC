@model Neurix.Models.CmsCtaSectionFormViewModel
@{
    ViewData["Title"] = L["Edit Call To Action Section"];
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan/10 text-cyan">#cta</span>
                <h1 class="text-2xl font-display font-bold tracking-tight text-foreground">@L["Edit Call To Action Section"]</h1>
            </div>
            <p class="text-sm text-muted-foreground mt-1">@L["Manage the bottom call to action banner, headline, contact email, button CTA, and background texture."]</p>
        </div>
        <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back to Sections"]
        </a>
    </div>

    <!-- Form -->
    <form asp-action="EditCta" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CompanyProfileId" />

        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-xs text-rose-500"></div>

        <!-- 1. Eyebrow Badge & Title -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-6">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="sparkles" class="w-4 h-4 text-cyan"></i>
                @L["Eyebrow Badge & Headline"]
            </h3>

            <!-- Badge -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="BadgeEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="BadgeEn" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="Let's Build Together" />
                    <span asp-validation-for="BadgeEn" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="BadgeAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="BadgeAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground font-arabic focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="لنبني معاً" />
                    <span asp-validation-for="BadgeAr" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <!-- Title (Prefix + Highlight) -->
            <div class="p-4 rounded-xl bg-background/50 border border-border space-y-4">
                <div>
                    <h4 class="text-xs font-bold text-foreground mb-2">@L["Title in English (Prefix + Glowing Highlight):"]</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="TitlePrefixEn" class="block text-[11px] text-muted-foreground mb-1">@L["Prefix"]</label>
                            <input asp-for="TitlePrefixEn" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="Ready to engineer" />
                        </div>
                        <div>
                            <label asp-for="TitleHighlightEn" class="block text-[11px] text-cyan mb-1">@L["Glowing Highlight"]</label>
                            <input asp-for="TitleHighlightEn" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground focus:ring-2 focus:ring-cyan focus:outline-none" placeholder=" your future?" />
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-t border-border/70">
                    <h4 class="text-xs font-bold text-foreground mb-2 font-arabic" dir="rtl">@L["Arabic Title (Prefix + Glowing Highlight):"]</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="TitlePrefixAr" class="block text-[11px] text-muted-foreground mb-1">@L["Prefix"]</label>
                            <input asp-for="TitlePrefixAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground font-arabic focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="مستعد لهندسة" />
                        </div>
                        <div>
                            <label asp-for="TitleHighlightAr" class="block text-[11px] text-cyan mb-1">@L["Glowing Highlight"]</label>
                            <input asp-for="TitleHighlightAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground font-arabic focus:ring-2 focus:ring-cyan focus:outline-none" placeholder=" مستقبلك؟" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Primary CTA Button & Direct Contact -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-6">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="mouse-pointer-click" class="w-4 h-4 text-cyan"></i>
                @L["Call to Action Button & Contact Info"]
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="ButtonTextEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="ButtonTextEn" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="Contact Us" />
                    <span asp-validation-for="ButtonTextEn" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="ButtonTextAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="ButtonTextAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground font-arabic focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="تواصل معنا" />
                    <span asp-validation-for="ButtonTextAr" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="ButtonUrl" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="ButtonUrl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground font-mono focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="/Home/Contact" />
                    <span asp-validation-for="ButtonUrl" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="ContactEmail" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="ContactEmail" type="email" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:ring-2 focus:ring-cyan focus:outline-none" placeholder="contact@neurix.ai" />
                    <span asp-validation-for="ContactEmail" class="text-xs text-rose-500"></span>
                </div>
            </div>
        </div>

        <!-- 3. Background Texture Image -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-6">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="image" class="w-4 h-4 text-cyan"></i>
                @L["Background Texture Image"]
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div class="md:col-span-4">
                    @if (!string.IsNullOrWhiteSpace(Model.BackgroundImagePath))
                    {
                        <div class="relative rounded-xl overflow-hidden border border-border aspect-[16/9] bg-muted/40 group">
                            <img src="@Url.Content(Model.BackgroundImagePath)" alt="Preview" class="w-full h-full object-cover" />
                            <div class="absolute inset-0 bg-background/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-2 text-center text-[11px] text-foreground font-mono truncate">
                                @Model.BackgroundImagePath
                            </div>
                        </div>
                    }
                </div>
                <div class="md:col-span-8 space-y-3">
                    <div>
                        <label asp-for="BackgroundImageFile" class="block text-xs font-medium text-muted-foreground mb-1.5">@L["Upload New Background Image (PNG, JPG, WebP)"]</label>
                        <input asp-for="BackgroundImageFile" type="file" accept="image/*" class="w-full text-xs text-muted-foreground file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-cyan/10 file:text-cyan hover:file:bg-cyan/20 cursor-pointer" />
                        <span asp-validation-for="BackgroundImageFile" class="text-xs text-rose-500"></span>
                    </div>
                    <div>
                        <label asp-for="BackgroundImagePath" class="block text-[11px] text-muted-foreground mb-1">@L["Or Specify Background Image Path / URL"]</label>
                        <input asp-for="BackgroundImagePath" class="w-full rounded-xl border border-border bg-background px-3 py-1.5 text-xs text-foreground font-mono focus:ring-2 focus:ring-cyan focus:outline-none" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Publishing Status & Submit -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <input asp-for="IsPublished" type="checkbox" class="h-4 w-4 rounded border-border text-cyan focus:ring-cyan bg-background" />
                <div>
                    <label asp-for="IsPublished" class="text-xs font-semibold text-foreground"></label>
                    <p class="text-[11px] text-muted-foreground">@L["When checked, this section is rendered on the public website."]</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="px-4 py-2 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                    @L["Cancel"]
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-xs font-semibold text-primary-foreground bg-button-gradient hover:scale-[1.02] shadow-[0_0_15px_hsl(var(--cyan)/0.25)] transition-all">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    @L["Save Changes"]
                </button>
            </div>
        </div>
    </form>
</div>
