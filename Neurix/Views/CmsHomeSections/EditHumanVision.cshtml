@model Neurix.Models.CmsHumanVisionSectionFormViewModel
@{
    ViewData["Title"] = L["Edit Human Vision Section"];
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-azure/10 text-azure">#vision-human</span>
                <h1 class="text-2xl font-display font-bold tracking-tight text-foreground">@L["Edit Human Vision Section"]</h1>
            </div>
            <p class="text-sm text-muted-foreground mt-1">@L["Manage core philosophy message, dual paragraphs on human-centric tech, and side illustration."]</p>
        </div>
        <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back to Sections"]
        </a>
    </div>

    <!-- Form -->
    <form asp-action="EditHumanVision" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CompanyProfileId" />

        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-xs text-rose-500"></div>

        <!-- 1. Eyebrow Badge & Title -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-6">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="sparkles" class="w-4 h-4 text-azure"></i>
                @L["Section Badge & Heading"]
            </h3>

            <!-- Badge -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="BadgeEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="BadgeEn" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:ring-2 focus:ring-azure focus:outline-none" />
                    <span asp-validation-for="BadgeEn" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="BadgeAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                    <input asp-for="BadgeAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground font-arabic focus:ring-2 focus:ring-azure focus:outline-none" />
                    <span asp-validation-for="BadgeAr" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <!-- Title (Prefix + Highlight) -->
            <div class="p-4 rounded-xl bg-background/50 border border-border space-y-4">
                <div>
                    <h4 class="text-xs font-bold text-foreground mb-2">@L["Title in English (Prefix + Glowing Highlight):"]</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="TitlePrefixEn" class="block text-[11px] text-muted-foreground mb-1">@L["Prefix"]</label>
                            <input asp-for="TitlePrefixEn" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground focus:ring-2 focus:ring-azure focus:outline-none" placeholder="Neurix AI " />
                        </div>
                        <div>
                            <label asp-for="TitleHighlightEn" class="block text-[11px] text-azure font-bold mb-1">@L["Highlight (Gradient)"]</label>
                            <input asp-for="TitleHighlightEn" class="w-full rounded-xl border border-azure/40 bg-azure/5 px-3 py-2 text-xs font-bold text-azure focus:ring-2 focus:ring-azure focus:outline-none" placeholder="Human Vision" />
                        </div>
                    </div>
                </div>

                <div dir="rtl">
                    <h4 class="text-xs font-bold text-foreground mb-2">@L["Arabic Title (Prefix + Glowing Word):"]</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="TitlePrefixAr" class="block text-[11px] text-muted-foreground mb-1">@L["Prefix"]</label>
                            <input asp-for="TitlePrefixAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs font-arabic text-foreground focus:ring-2 focus:ring-azure focus:outline-none" placeholder="رؤية نيوركس AI " />
                        </div>
                        <div>
                            <label asp-for="TitleHighlightAr" class="block text-[11px] text-azure font-bold mb-1">@L["Highlight (Gradient)"]</label>
                            <input asp-for="TitleHighlightAr" dir="rtl" class="w-full rounded-xl border border-azure/40 bg-azure/5 px-3 py-2 text-xs font-bold font-arabic text-azure focus:ring-2 focus:ring-azure focus:outline-none" placeholder="الإنسانية" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Dual Paragraphs (Narrative) -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-6">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="book-open" class="w-4 h-4 text-cyan"></i>
                @L["Core Narrative Paragraphs"]
            </h3>

            <!-- Paragraph 1 -->
            <div class="p-4 rounded-xl bg-background/50 border border-border space-y-3">
                <h4 class="text-xs font-bold text-foreground">@L["Paragraph 1 (The Challenge / Problem Statement)"]</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Paragraph1En" class="block text-xs text-muted-foreground mb-1.5"></label>
                        <textarea asp-for="Paragraph1En" rows="4" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-xs text-foreground focus:ring-2 focus:ring-azure focus:outline-none"></textarea>
                        <span asp-validation-for="Paragraph1En" class="text-xs text-rose-500"></span>
                    </div>
                    <div>
                        <label asp-for="Paragraph1Ar" class="block text-xs text-muted-foreground mb-1.5"></label>
                        <textarea asp-for="Paragraph1Ar" rows="4" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-xs text-foreground font-arabic focus:ring-2 focus:ring-azure focus:outline-none"></textarea>
                        <span asp-validation-for="Paragraph1Ar" class="text-xs text-rose-500"></span>
                    </div>
                </div>
            </div>

            <!-- Paragraph 2 -->
            <div class="p-4 rounded-xl bg-background/50 border border-border space-y-3">
                <h4 class="text-xs font-bold text-foreground">@L["Paragraph 2 (Our Mission / Constructive Action)"]</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Paragraph2En" class="block text-xs text-muted-foreground mb-1.5"></label>
                        <textarea asp-for="Paragraph2En" rows="5" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-xs text-foreground focus:ring-2 focus:ring-azure focus:outline-none"></textarea>
                        <span asp-validation-for="Paragraph2En" class="text-xs text-rose-500"></span>
                    </div>
                    <div>
                        <label asp-for="Paragraph2Ar" class="block text-xs text-muted-foreground mb-1.5"></label>
                        <textarea asp-for="Paragraph2Ar" rows="5" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-xs text-foreground font-arabic focus:ring-2 focus:ring-azure focus:outline-none"></textarea>
                        <span asp-validation-for="Paragraph2Ar" class="text-xs text-rose-500"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Side Illustration & Media Upload -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-4">
            <h3 class="text-sm font-semibold text-foreground flex items-center gap-2 border-b border-border pb-3">
                <i data-lucide="image" class="w-4 h-4 text-cyan"></i>
                @L["Illustration Image Asset"]
            </h3>

            <div class="flex flex-col sm:flex-row items-start gap-6">
                <!-- Preview Thumbnail -->
                <div class="w-36 h-36 rounded-2xl bg-card border border-border flex items-center justify-center overflow-hidden shrink-0 shadow-inner relative group p-1">
                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <img id="vision-img-preview" src="@Model.ImagePath" alt="Vision Illustration" class="w-full h-full object-cover rounded-xl" />
                    }
                    else
                    {
                        <i id="vision-img-placeholder" data-lucide="image" class="w-10 h-10 text-muted-foreground/50"></i>
                        <img id="vision-img-preview" src="" alt="Vision Illustration" class="w-full h-full object-cover rounded-xl hidden" />
                    }
                </div>

                <!-- Upload Fields -->
                <div class="flex-1 space-y-3 w-full">
                    <div>
                        <label asp-for="ImageFile" class="block text-xs font-semibold text-foreground mb-1.5">@L["Upload New Image"]</label>
                        <input asp-for="ImageFile" type="file" accept=".png,.jpg,.jpeg,.webp,.svg"
                               onchange="previewImageFile(this, 'vision-img-preview', 'vision-img-placeholder')"
                               class="w-full text-xs text-muted-foreground file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-azure/10 file:text-azure hover:file:bg-azure/20 cursor-pointer" />
                        <span asp-validation-for="ImageFile" class="text-xs text-rose-500"></span>
                    </div>

                    <div>
                        <label asp-for="ImagePath" class="block text-[11px] text-muted-foreground mb-1">@L["Or Current File Path / URL:"]</label>
                        <input asp-for="ImagePath" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs font-mono text-foreground focus:ring-2 focus:ring-azure focus:outline-none" />
                        <span asp-validation-for="ImagePath" class="text-xs text-rose-500"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                        <div>
                            <label asp-for="ImageAltEn" class="block text-[11px] text-muted-foreground mb-1">@L["Alt Text (EN)"]</label>
                            <input asp-for="ImageAltEn" class="w-full rounded-xl border border-border bg-background px-3 py-1.5 text-xs text-foreground focus:ring-2 focus:ring-azure focus:outline-none" />
                        </div>
                        <div>
                            <label asp-for="ImageAltAr" class="block text-[11px] text-muted-foreground mb-1">@L["Alt Text (AR)"]</label>
                            <input asp-for="ImageAltAr" dir="rtl" class="w-full rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-arabic text-foreground focus:ring-2 focus:ring-azure focus:outline-none" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Status & Submit -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <input asp-for="IsPublished" type="checkbox" class="w-4 h-4 rounded border-border text-azure focus:ring-azure" />
                <label asp-for="IsPublished" class="text-sm font-medium text-foreground cursor-pointer">@L["Published on Live Website"]</label>
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="px-5 py-2.5 rounded-xl border border-border text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                    @L["Cancel"]
                </a>
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-xs font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:scale-105 transition-all">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    @L["Save Human Vision Changes"]
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImageFile(input, imgId, placeholderId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById(imgId);
                    const placeholder = document.getElementById(placeholderId);
                    if (img) {
                        img.src = e.target.result;
                        img.classList.remove('hidden');
                    }
                    if (placeholder) {
                        placeholder.classList.add('hidden');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
