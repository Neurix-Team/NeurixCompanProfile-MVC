@model Neurix.Models.CmsSocialLinkDetailsViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = $"Social Link — {Model.SocialLink.DisplayName ?? Model.SocialLink.Platform}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground mb-1">
                <a asp-action="Index" class="hover:text-foreground">@L["Social Links"]</a>
                <span>/</span>
                <span class="text-foreground">@L["Details"]</span>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-foreground font-display capitalize">
                @(Model.SocialLink.DisplayName ?? Model.SocialLink.Platform)
            </h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold border border-border bg-card hover:bg-muted text-foreground transition-all">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i>
                @L["Back to List"]
            </a>
            <a asp-action="Edit" asp-route-id="@Model.SocialLink.Id"
               class="inline-flex items-center gap-2 rounded-xl bg-cyan/15 text-cyan border border-cyan/30 hover:bg-cyan/25 px-4 py-2 text-xs font-semibold transition-all">
                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                @L["Edit Link"]
            </a>
        </div>
    </div>

    <!-- Main Card -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-border pb-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-cyan/10 text-cyan flex items-center justify-center">
                    <i data-lucide="@(string.IsNullOrWhiteSpace(Model.SocialLink.IconName) ? "share-2" : Model.SocialLink.IconName)" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-foreground capitalize">@(Model.SocialLink.DisplayName ?? Model.SocialLink.Platform)</h3>
                    <p class="text-xs text-cyan font-semibold">@Model.SocialLink.CompanyNameEn</p>
                </div>
            </div>
            <partial name="_CmsStatusBadge" model="Model.SocialLink.IsPublished" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div>
                <span class="text-xs font-semibold text-muted-foreground block mb-1">@L["Platform"]</span>
                <span class="font-mono text-foreground">@Model.SocialLink.Platform</span>
            </div>

            <div>
                <span class="text-xs font-semibold text-muted-foreground block mb-1">@L["Display Order"]</span>
                <span class="text-foreground">#@Model.SocialLink.DisplayOrder</span>
            </div>

            <div class="md:col-span-2">
                <span class="text-xs font-semibold text-muted-foreground block mb-1">@L["Target URL"]</span>
                <a href="@Model.SocialLink.Url" target="_blank" class="font-mono text-cyan hover:underline break-all inline-flex items-center gap-1.5">
                    @Model.SocialLink.Url
                    <i data-lucide="external-link" class="w-3 h-3"></i>
                </a>
            </div>

            <div>
                <span class="text-xs font-semibold text-muted-foreground block mb-1">@L["Created (UTC)"]</span>
                <span class="text-xs text-muted-foreground">@Model.SocialLink.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>

            <div>
                <span class="text-xs font-semibold text-muted-foreground block mb-1">@L["Last Updated (UTC)"]</span>
                <span class="text-xs text-muted-foreground">@(Model.SocialLink.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</span>
            </div>
        </div>
    </div>
</div>
