@model Neurix.Models.CmsSocialLinkFormViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = "Create Social Link";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground mb-1">
                <a asp-action="Index" class="hover:text-foreground">@L["Social Links"]</a>
                <span>/</span>
                <span class="text-foreground">@L["Create"]</span>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-foreground font-display">@L["Add New Social Link"]</h2>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold border border-border bg-card hover:bg-muted text-foreground transition-all">
            <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i>
            @L["Back to List"]
        </a>
    </div>

    <!-- Form -->
    <form asp-action="Create" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rounded-xl bg-rose-500/10 border border-rose-500/20 p-4 text-xs text-rose-400"></div>

        <partial name="_SocialLinkFields" model="Model" />

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-border text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all">
                @L["Cancel"]
            </a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-button-gradient px-6 py-2.5 text-xs font-semibold text-primary-foreground shadow-lg shadow-azure/20 hover:scale-[1.02] hover:shadow-azure/30 transition-all duration-300">
                <i data-lucide="save" class="w-4 h-4"></i>
                @L["Create Social Link"]
            </button>
        </div>
    </form>
</div>
