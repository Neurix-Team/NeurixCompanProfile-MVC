@model Neurix.Models.CmsSocialLinkFormViewModel

<div class="space-y-8">
    <!-- Brand & Platform Settings -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="share-2" class="w-5 h-5 text-cyan"></i>
            <h3 class="text-base font-bold text-foreground">@L["Brand Association & Platform"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Company Profile Dropdown -->
            <div>
                <label asp-for="CompanyProfileId" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <select asp-for="CompanyProfileId" asp-items="Model.CompanyOptions" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30">
                </select>
                <span asp-validation-for="CompanyProfileId" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Platform Identifier -->
            <div>
                <label asp-for="Platform" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="Platform" list="platform-suggestions" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-mono placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. linkedin, twitter, github, youtube"]' />
                <datalist id="platform-suggestions">
                    <option value="linkedin">LinkedIn</option>
                    <option value="twitter">Twitter / X</option>
                    <option value="github">GitHub</option>
                    <option value="youtube">YouTube</option>
                    <option value="facebook">Facebook</option>
                    <option value="instagram">Instagram</option>
                    <option value="globe">@L["Website / Portal"]</option>
                </datalist>
                <span asp-validation-for="Platform" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Display Order -->
            <div>
                <label asp-for="DisplayOrder" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="DisplayOrder" type="number" min="0" max="1000" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" />
                <span asp-validation-for="DisplayOrder" class="text-xs text-rose-500 mt-1 block"></span>
            </div>
        </div>
    </div>

    <!-- URL & Visual Attributes -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="link" class="w-5 h-5 text-azure"></i>
            <h3 class="text-base font-bold text-foreground">@L["Target URL & Appearance"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Target URL -->
            <div class="md:col-span-2">
                <label asp-for="Url" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="Url" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-mono placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="https://www.linkedin.com/company/neurixuk/" />
                <span asp-validation-for="Url" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Display Name -->
            <div>
                <label asp-for="DisplayName" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="DisplayName" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. LinkedIn"]' />
                <span asp-validation-for="DisplayName" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground mt-1">@L["Optional friendly label or accessibility aria-label."]</p>
            </div>

            <!-- Lucide Icon Name -->
            <div>
                <label asp-for="IconName" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="IconName" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. linkedin, twitter, github, youtube, globe"]' />
                <span asp-validation-for="IconName" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground mt-1">@L["Lucide icon identifier (e.g. 'linkedin', 'twitter', 'github', 'youtube', 'facebook', 'instagram', 'globe')."]</p>
            </div>
        </div>
    </div>

    <!-- Publishing Options -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-4">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="eye" class="w-5 h-5 text-emerald-400"></i>
            <h3 class="text-base font-bold text-foreground">@L["Publishing Status"]</h3>
        </div>

        <div class="flex items-start gap-3 pt-2">
            <input asp-for="IsPublished" type="checkbox" class="mt-1 h-4 w-4 rounded border-border text-cyan focus:ring-cyan/30" />
            <div>
                <label asp-for="IsPublished" class="text-sm font-semibold text-foreground cursor-pointer">@L["Published and visible on the website footer"]</label>
                <p class="text-xs text-muted-foreground">@L["When unchecked, this social link is stored as a draft and hidden from visitors."]</p>
            </div>
        </div>
    </div>
</div>
