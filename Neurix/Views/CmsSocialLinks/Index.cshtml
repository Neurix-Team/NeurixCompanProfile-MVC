@model Neurix.Models.CmsSocialLinkListViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = "Social Links Management";
}

<div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold tracking-tight text-foreground font-display">@L["Social Media & Community Links"]</h2>
            <p class="text-sm text-muted-foreground mt-1">
                @L["Manage social channels and profiles displayed in the website footer for each brand."]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 rounded-xl bg-button-gradient px-4 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-azure/20 hover:scale-[1.02] hover:shadow-azure/30 transition-all duration-300">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add Social Link"]
            </a>
        </div>
    </div>

    @if (Model.Companies.Count > 1)
    {
        <!-- Company Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2 border-b border-border pb-4">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(!Model.SelectedCompanyId.HasValue ? "bg-cyan/15 text-cyan border border-cyan/30" : "text-muted-foreground hover:text-foreground hover:bg-muted border border-transparent")">
                <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                All Brands (@Model.SocialLinks.Count)
            </a>
            @foreach (var company in Model.Companies)
            {
                var isSelected = Model.SelectedCompanyId == company.Id;
                <a asp-action="Index" asp-route-companyId="@company.Id"
                   class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(isSelected ? "bg-cyan/15 text-cyan border border-cyan/30" : "text-muted-foreground hover:text-foreground hover:bg-muted border border-transparent")">
                    <i data-lucide="building" class="w-3.5 h-3.5"></i>
                    @company.NameEn
                </a>
            }
        </div>
    }

    <!-- Social Links Grid / Cards -->
    @if (Model.SocialLinks.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-border bg-card/40 p-12 text-center">
            <div class="w-12 h-12 rounded-2xl bg-cyan/10 text-cyan flex items-center justify-center mx-auto mb-4">
                <i data-lucide="share-2" class="w-6 h-6"></i>
            </div>
            <h3 class="text-base font-semibold text-foreground">@L["No Social Links Found"]</h3>
            <p class="text-xs text-muted-foreground mt-1 max-w-sm mx-auto">
                @L["No social links have been configured for the selected filter yet."]
            </p>
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 mt-4 rounded-xl bg-card border border-border hover:bg-muted px-4 py-2 text-xs font-semibold text-foreground transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                @L["Add First Social Link"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var link in Model.SocialLinks)
            {
                <div class="group relative rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-5 hover:border-cyan/40 hover:shadow-lg hover:shadow-cyan/5 transition-all duration-300 flex flex-col justify-between">
                    <!-- Top Row: Icon, Platform, Brand Badge, Publish Status -->
                    <div>
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan/15 to-azure/10 border border-cyan/20 flex items-center justify-center text-cyan shrink-0 group-hover:scale-105 transition-transform">
                                    <i data-lucide="@(string.IsNullOrWhiteSpace(link.IconName) ? "share-2" : link.IconName)" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-foreground capitalize">@(link.DisplayName ?? link.Platform)</h4>
                                    <span class="inline-block text-[11px] font-medium text-cyan/90">@link.CompanyNameEn</span>
                                </div>
                            </div>
                            <div>
                                <partial name="_CmsStatusBadge" model="link.IsPublished" />
                            </div>
                        </div>

                        <!-- URL Preview -->
                        <div class="mb-4">
                            <a href="@link.Url" target="_blank" class="text-xs text-muted-foreground hover:text-cyan break-all font-mono inline-flex items-center gap-1.5 transition-colors">
                                <span class="truncate max-w-[240px]">@link.Url</span>
                                <i data-lucide="external-link" class="w-3 h-3 shrink-0"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Footer: Order & Action Buttons -->
                    <div class="pt-4 border-t border-border flex items-center justify-between gap-2 mt-auto">
                        <span class="text-[11px] text-muted-foreground/80 font-mono">
                            Order: #@link.DisplayOrder
                        </span>

                        <div class="flex items-center gap-1">
                            <!-- Toggle publish -->
                            <form asp-action="TogglePublish" asp-route-id="@link.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isPublished" value="@((!link.IsPublished).ToString().ToLowerInvariant())" />
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" title='@(link.IsPublished ? L["Unpublish link"] : L["Publish link"])'
                                        class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                                    <i data-lucide="@(link.IsPublished ? "eye-off" : "eye")" class="w-4 h-4"></i>
                                </button>
                            </form>

                            <!-- Edit -->
                            <a asp-action="Edit" asp-route-id="@link.Id" title='@L["Edit social link"]'
                               class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                            </a>

                            <!-- Delete -->
                            <form asp-action="Delete" asp-route-id="@link.Id" method="post" class="inline" onsubmit="return confirm('@L["Are you sure you want to delete this social link?"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" title='@L["Delete social link"]'
                                        class="p-1.5 rounded-lg text-muted-foreground hover:text-rose-400 hover:bg-rose-500/10 transition-colors">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
