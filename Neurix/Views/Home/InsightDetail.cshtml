@model Neurix.BLL.Dtos.Cms.CmsBlogPostDetailDto
@{
    ViewData["Title"] = Model.TitleEn;
}

<article class="relative pt-32 pb-24">
    <div class="container px-5 sm:px-6 max-w-4xl">

        @* Header *@
        <header class="space-y-6 mb-12">
            <div class="flex flex-wrap items-center gap-3 text-xs">
                <span class="rounded-full bg-cyan/10 px-3.5 py-1 font-semibold text-cyan">
                    @(Model.Category ?? "AI Research")
                </span>
                <span class="text-slate-500 dark:text-slate-400">@Model.ReadTimeMinutes min read</span>
                <span class="text-slate-500 dark:text-slate-400">•</span>
                <span class="text-slate-500 dark:text-slate-400">@(Model.PublishedAtUtc?.ToString("MMMM dd, yyyy") ?? "Recent")</span>
            </div>

            <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.2]">
                <span data-en="@Model.TitleEn" data-ar="@Model.TitleAr">@Model.TitleEn</span>
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.SummaryEn) || !string.IsNullOrWhiteSpace(Model.SummaryAr))
            {
                <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-light"
                   data-en="@Model.SummaryEn" data-ar="@Model.SummaryAr">
                    @Model.SummaryEn
                </p>
            }

            <div class="flex items-center gap-3 pt-4 border-t border-slate-200 dark:border-white/10">
                <div class="w-10 h-10 rounded-full bg-cyan/10 border border-cyan/20 flex items-center justify-center text-cyan font-bold text-sm">
                    @(string.IsNullOrWhiteSpace(Model.AuthorNameEn) ? "N" : Model.AuthorNameEn.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <div class="text-sm font-semibold text-slate-900 dark:text-white"
                         data-en="@(Model.AuthorNameEn ?? "Neurix Research Team")"
                         data-ar="@(Model.AuthorNameAr ?? "فريق أبحاث نيوركس")">
                        @(Model.AuthorNameEn ?? "Neurix Research Team")
                    </div>
                    <div class="text-xs text-slate-500 dark:text-slate-400"
                         data-en="@Model.CompanyNameEn Ecosystem"
                         data-ar="منظومة @Model.CompanyNameEn">
                        @Model.CompanyNameEn Ecosystem
                    </div>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
        {
            <div class="rounded-3xl overflow-hidden mb-12 border border-slate-300 dark:border-white/10 shadow-2xl">
                <img src="@Model.CoverImagePath" alt="@Model.TitleEn" class="w-full h-auto object-cover max-h-[480px]" />
            </div>
        }

        @* Content Body *@
        <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-200 leading-relaxed space-y-6">
            <div data-en="@(string.IsNullOrWhiteSpace(Model.BodyEn) ? Model.SummaryEn : Model.BodyEn)"
                 data-ar="@(string.IsNullOrWhiteSpace(Model.BodyAr) ? Model.SummaryAr : Model.BodyAr)">
                @Html.Raw(string.IsNullOrWhiteSpace(Model.BodyEn) ? Model.SummaryEn : Model.BodyEn)
            </div>
        </div>

        @* Share & CTA *@
        <div class="mt-16 pt-8 border-t border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500" data-en="Share Article" data-ar="مشاركة المقال">Share</span>
                <a href="https://twitter.com/intent/tweet?text=@Uri.EscapeDataString(Model.TitleEn)" target="_blank"
                   class="w-9 h-9 rounded-full border border-slate-300 dark:border-white/10 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-cyan hover:border-cyan transition-colors">
                    <partial name="_SocialIcon" model="@("twitter")" />
                </a>
                <a href="https://www.linkedin.com/sharing/share-offsite/" target="_blank"
                   class="w-9 h-9 rounded-full border border-slate-300 dark:border-white/10 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-cyan hover:border-cyan transition-colors">
                    <partial name="_SocialIcon" model="@("linkedin")" />
                </a>
            </div>

            <a asp-action="Contact" class="inline-flex items-center gap-2 rounded-xl bg-button-gradient px-5 py-2.5 text-xs font-semibold text-primary-foreground hover:shadow-[0_0_20px_hsl(var(--cyan)/0.4)] transition-all">
                <span data-en="Collaborate with Labs" data-ar="تعاون مع المختبرات">Collaborate with Labs</span>
                <i data-lucide="arrow-right" class="w-4 h-4 rtl-flip"></i>
            </a>
        </div>

    </div>
</article>
