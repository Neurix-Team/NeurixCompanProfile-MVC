@model IReadOnlyList<Neurix.BLL.Dtos.Cms.CmsBlogPostSummaryDto>
@using Neurix.BLL.Common
@using Neurix.BLL.Dtos.Cms
@using Neurix.Common
@{
    ViewData["Title"] = "Insights & Research";

    // ── CMS-managed band (/cms/page-sections/insights) ──
    var bands = CmsBandText.Bands(ViewData["PageBands"]);
    var heroBand = bands.Band(CmsPageKeys.Bands.Hero);

    var badgeEn = CmsBandText.Pick(heroBand?.BadgeEn, "Thought Leadership & Research");
    var badgeAr = CmsBandText.Pick(heroBand?.BadgeAr, "الريادة الفكرية والأبحاث");
    var prefixEn = CmsBandText.Pick(heroBand?.TitlePrefixEn, "Insights & ");
    var prefixAr = CmsBandText.Pick(heroBand?.TitlePrefixAr, "رؤى و ");
    var highlightEn = CmsBandText.Pick(heroBand?.TitleHighlightEn, "Publications");
    var highlightAr = CmsBandText.Pick(heroBand?.TitleHighlightAr, "منشورات");
    var bodyEn = CmsBandText.Pick(heroBand?.BodyEn, "Explore the latest scientific breakthroughs, architectural paradigms, and strategic perspectives from the Neurix AI ecosystem.");
    var bodyAr = CmsBandText.Pick(heroBand?.BodyAr, "استكشف أحدث الاختراقات العلمية، والمعماريات البرمجية، والرؤى الاستراتيجية الصادرة عن منظومة نيوركس AI.");
    var emptyEn = CmsBandText.Pick(heroBand?.EmptyStateEn, "No insights published yet. Check back soon for new research papers.");
    var emptyAr = CmsBandText.Pick(heroBand?.EmptyStateAr, "لم تُنشر أي مقالات بعد. يرجى المتابعة لاحقاً للاطلاع على أوراق البحث الجديدة.");
    var readMoreEn = CmsBandText.Pick(heroBand?.ItemLinkTextEn, "Read Article");
    var readMoreAr = CmsBandText.Pick(heroBand?.ItemLinkTextAr, "اقرأ المقال");

    // Per-card labels come from the homepage band's header row so the wording matches there.
    var meta = ViewData["CardMeta"] as CmsListSectionHeaderDto;
    var fallbackCategoryEn = CmsBandText.Pick(meta?.DefaultCategoryLabelEn, "Research");
    var fallbackCategoryAr = CmsBandText.Pick(meta?.DefaultCategoryLabelAr, "أبحاث");
    var readTimeEn = CmsBandText.Pick(meta?.ReadTimeSuffixEn, "min read");
    var readTimeAr = CmsBandText.Pick(meta?.ReadTimeSuffixAr, "دقيقة قراءة");
    var undatedEn = CmsBandText.Pick(meta?.UndatedLabelEn, "Recent");
    var undatedAr = CmsBandText.Pick(meta?.UndatedLabelAr, "حديثاً");
}

@if (heroBand?.IsPublished != false)
{
    <section class="relative min-h-[50vh] flex flex-col items-center justify-center pt-32 pb-16 overflow-hidden">
        <div class="absolute inset-0 z-0 bg-hero-radial" aria-hidden="true"></div>
        <div class="absolute inset-0 z-0 bg-grid-pattern pointer-events-none" aria-hidden="true"></div>

        <div class="container relative z-30 text-center max-w-4xl px-5 sm:px-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-8 animate-fade-in">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse"></span>
                <span data-en="@badgeEn" data-ar="@badgeAr">@badgeEn</span>
            </div>

            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">
                <span data-en="@prefixEn" data-ar="@prefixAr">@prefixEn</span>
                <span class="text-gradient-brand" data-en="@highlightEn" data-ar="@highlightAr">@highlightEn</span>
            </h1>

            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto"
               data-en="@bodyEn"
               data-ar="@bodyAr">
                @bodyEn
            </p>
        </div>
    </section>
}

<section class="relative py-16">
    <div class="container px-5 sm:px-6 max-w-6xl">
        @if (Model == null || Model.Count == 0)
        {
            <div class="rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 p-16 text-center text-slate-500">
                <p data-en="@emptyEn"
                   data-ar="@emptyAr">
                    @emptyEn
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var post in Model)
                {
                    <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-md p-6 sm:p-7 transition-all duration-300 hover:border-cyan/50 hover:-translate-y-1 hover:shadow-[0_0_30px_hsl(var(--cyan)/0.2)]">
                        <div class="space-y-4">
                            @if (!string.IsNullOrWhiteSpace(post.CoverImagePath))
                            {
                                <div class="relative aspect-video rounded-2xl overflow-hidden bg-muted/40 mb-4">
                                    <img src="@post.CoverImagePath" alt="@post.TitleEn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                </div>
                            }

                            @{
                                // A post's own category is a single non-bilingual column, so it
                                // stands for both languages; only the fallback differs.
                                var categoryEn = CmsBandText.Pick(post.Category, fallbackCategoryEn);
                                var categoryAr = CmsBandText.Pick(post.Category, fallbackCategoryAr);
                            }
                            <div class="flex items-center justify-between gap-2 text-xs">
                                @if (!string.IsNullOrWhiteSpace(categoryEn) || !string.IsNullOrWhiteSpace(categoryAr))
                                {
                                    <span class="rounded-full bg-cyan/10 px-3 py-1 font-semibold text-cyan"
                                          data-en="@categoryEn" data-ar="@categoryAr">
                                        @categoryEn
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(readTimeEn))
                                {
                                    <span class="text-slate-500 dark:text-slate-400"
                                          data-en="@post.ReadTimeMinutes @readTimeEn" data-ar="@post.ReadTimeMinutes @readTimeAr">@post.ReadTimeMinutes @readTimeEn</span>
                                }
                            </div>

                            <h2 class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cyan transition-colors line-clamp-2">
                                <span data-en="@post.TitleEn" data-ar="@post.TitleAr">@post.TitleEn</span>
                            </h2>

                            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3"
                               data-en="@post.SummaryEn" data-ar="@post.SummaryAr">
                                @post.SummaryEn
                            </p>
                        </div>

                        <div class="pt-6 mt-6 border-t border-slate-200 dark:border-white/10 flex items-center justify-between">
                            @{
                                var publishedOn = post.PublishedAtUtc?.ToString("MMM dd, yyyy");
                                var publishedEn = publishedOn ?? undatedEn;
                                var publishedAr = publishedOn ?? undatedAr;
                            }
                            <span class="text-xs text-slate-500 dark:text-slate-400"
                                  data-en="@publishedEn" data-ar="@publishedAr">
                                @publishedEn
                            </span>

                            @if (!string.IsNullOrWhiteSpace(readMoreEn))
                            {
                                <a asp-action="InsightDetail" asp-route-slug="@post.Slug"
                                   class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan hover:underline">
                                    <span data-en="@readMoreEn" data-ar="@readMoreAr">@readMoreEn</span>
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 rtl-flip"></i>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
