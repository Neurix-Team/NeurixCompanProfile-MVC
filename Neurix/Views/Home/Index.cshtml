                {
                <a href="@div.Url"
                   class="magnetic-card division-card card-glow-border group relative flex flex-col rounded-2xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-xl p-7 md:p-8 transition-all duration-500 ease-out hover:border-cyan/70 hover:-translate-y-1 hover:shadow-[0_0_0_1px_hsl(var(--cyan)/0.4),0_0_40px_-5px_hsl(var(--cyan)/0.45)] dark:hover:shadow-[0_0_0_1px_hsl(var(--cyan)/0.6),0_0_50px_-5px_hsl(var(--cyan)/0.55)] opacity-0 translate-y-6"
                   style="transition-delay: @(idx * 110)ms;"
                   data-animate="stagger">
                    <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-xl border border-slate-300 dark:border-white/10 bg-slate-50/70 dark:bg-background/60 text-cyan transition-all duration-500 group-hover:border-cyan/60 group-hover:shadow-[0_0_20px_hsl(var(--cyan)/0.4)] group-hover:scale-110">
                        <i data-lucide="@div.Icon" class="h-5 w-5"></i>
                    </div>
                    <h3 class="font-display text-xl md:text-2xl font-semibold text-slate-900 dark:text-white mb-3 transition-colors duration-300 group-hover:text-cyan-600 dark:group-hover:text-cyan-400"
                        data-en="@div.TitleEn" data-ar="@div.TitleAr">
                        @div.TitleEn
                    </h3>
                    <p class="text-sm md:text-[15px] text-slate-700 dark:text-slate-300 leading-relaxed"
                       data-en="@div.DescEn" data-ar="@div.DescAr">
                        @div.DescEn
                    </p>
                    <div class="mt-8 flex items-center justify-end gap-1.5 text-sm font-semibold text-azure transition-all duration-300 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 group-hover:gap-2.5"
                         data-en="@div.LinkTextEn" data-ar="@div.LinkTextAr">
                        @div.LinkTextEn
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 rtl-flip">
                            <path d="m9 18 6-6-6-6"></path>
                        </svg>
                    </div>
                    <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                         style="background: radial-gradient(circle at top right, hsl(var(--cyan) / 0.08), transparent 60%);"
                         aria-hidden="true"></div>
                </a>
                idx++;
                }
            </div>
        }
    </div>
</section>
}

@* ═══════════════════════════════════════════════════════════
   VISION & IMPLEMENTATION FRAMEWORK
   ═══════════════════════════════════════════════════════════ *@
@if (ethics?.IsPublished != false)
{
<section id="ethics" class="relative py-24 md:py-32 z-30 overflow-hidden bg-slate-50/50 dark:bg-background/20">
    @* Half Background ("infrastructure") - faded bright modern server room *@
    <div class="absolute inset-y-0 right-0 w-full lg:w-1/2 opacity-25 dark:opacity-[0.06] mix-blend-overlay pointer-events-none z-0">
        <img src="@ethicsBgImg" alt="Infrastructure Background" class="w-full h-full object-cover object-right" />
        @* Smooth gradient transition to transparent *@
        <div class="absolute inset-0 bg-gradient-to-r from-slate-50 dark:from-background via-slate-50/40 dark:via-background/40 to-transparent"></div>
    </div>

    <div class="container px-6 max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            
            @* Left Side (55% space - lg:col-span-7) *@
            <div class="lg:col-span-7 flex flex-col text-left rtl:text-right">
                <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-6 self-start">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                    <span data-en="@ethicsBadgeEn" data-ar="@ethicsBadgeAr">@ethicsBadgeEn</span>
                </div>
                
                <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight mb-6">
                    <span data-en="@ethicsTitlePrefixEn" data-ar="@ethicsTitlePrefixAr">@ethicsTitlePrefixEn</span>
                    <span class="text-gradient-brand" data-en="@ethicsTitleHighlightEn" data-ar="@ethicsTitleHighlightAr">@ethicsTitleHighlightEn</span>
                </h2>
                
                <p class="text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-10"
                   data-en="@ethicsDescEn"
                   data-ar="@ethicsDescAr">
                    @ethicsDescEn
                </p>

                @* 2x2 Grid of Dynamic CMS Services *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    @if (Model?.Services != null && Model.Services.Any())
                    {
                        var serviceGradients = new[] {
                            new { Border = "hover:border-cyan/50", Shadow = "hover:shadow-[0_0_20px_-5px_hsl(var(--cyan)/0.15)] dark:hover:shadow-[0_0_30px_-5px_hsl(var(--cyan)/0.2)]", IconBg = "bg-cyan/10", IconText = "text-cyan" },
                            new { Border = "hover:border-azure/50", Shadow = "hover:shadow-[0_0_20px_-5px_hsl(var(--azure)/0.15)] dark:hover:shadow-[0_0_30px_-5px_hsl(var(--azure)/0.2)]", IconBg = "bg-azure/10", IconText = "text-azure" },
                            new { Border = "hover:border-purple-500/50", Shadow = "hover:shadow-[0_0_20px_-5px_rgba(168,85,247,0.15)] dark:hover:shadow-[0_0_30px_-5px_rgba(168,85,247,0.2)]", IconBg = "bg-purple-500/10", IconText = "text-purple-500" },
                            new { Border = "hover:border-emerald-500/50", Shadow = "hover:shadow-[0_0_20px_-5px_rgba(16,185,129,0.15)] dark:hover:shadow-[0_0_30px_-5px_rgba(16,185,129,0.2)]", IconBg = "bg-emerald-500/10", IconText = "text-emerald-500" }
                        };
                        int sIdx = 0;

                        @foreach (var s in Model.Services.Take(4))
                        {
                            var theme = serviceGradients[sIdx % serviceGradients.Length];
                            var icon = !string.IsNullOrWhiteSpace(s.IconName) ? s.IconName : "cpu";

                            <div class="group relative flex flex-col rounded-2xl border border-slate-300/80 dark:border-white/10 bg-slate-100/40 dark:bg-card/20 backdrop-blur-md p-6 transition-all duration-300 @theme.Border @theme.Shadow">
                                <div class="w-10 h-10 rounded-xl @theme.IconBg flex items-center justify-center @theme.IconText mb-4 transition-transform duration-300 group-hover:scale-110">
                                    <i data-lucide="@icon" class="w-5 h-5"></i>
                                </div>
                                <h4 class="font-bold text-slate-900 dark:text-white mb-2 text-base" data-en="@s.NameEn" data-ar="@s.NameAr">@s.NameEn</h4>
                                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed"
                                   data-en="@s.ShortDescriptionEn"
                                   data-ar="@s.ShortDescriptionAr">
                                    @s.ShortDescriptionEn
                                </p>
                            </div>
                            sIdx++;
                        }
                    }
                    else
                    {
                        <!-- Fallback cards if CMS database is momentarily empty -->
                        <div class="group relative flex flex-col rounded-2xl border border-slate-300/80 dark:border-white/10 bg-slate-100/40 dark:bg-card/20 backdrop-blur-md p-6 transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_20px_-5px_hsl(var(--cyan)/0.15)] dark:hover:shadow-[0_0_30px_-5px_hsl(var(--cyan)/0.2)]">
                            <div class="w-10 h-10 rounded-xl bg-cyan/10 flex items-center justify-center text-cyan mb-4 transition-transform duration-300 group-hover:scale-110">
                                <i data-lucide="microscope" class="w-5 h-5"></i>
                            </div>
                            <h4 class="font-bold text-slate-900 dark:text-white mb-2 text-base" data-en="Research & Development" data-ar="البحث والتطوير">Research & Development</h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed" data-en="Driving analytical development, scientific research, and applied technology solutions through Neurix AI Lab." data-ar="قيادة التطوير التحليلي، والبحث العلمي، وحلول التكنولوجيا التطبيقية من خلال مختبر نيوركس AI.">
                                Driving analytical development, scientific research, and applied technology solutions through Neurix AI Lab.
                            </p>
                        </div>
                        <div class="group relative flex flex-col rounded-2xl border border-slate-300/80 dark:border-white/10 bg-slate-100/40 dark:bg-card/20 backdrop-blur-md p-6 transition-all duration-300 hover:border-azure/50 hover:shadow-[0_0_20px_-5px_hsl(var(--azure)/0.15)] dark:hover:shadow-[0_0_30px_-5px_hsl(var(--azure)/0.2)]">
                            <div class="w-10 h-10 rounded-xl bg-azure/10 flex items-center justify-center text-azure mb-4 transition-transform duration-300 group-hover:scale-110">
                                <i data-lucide="code" class="w-5 h-5"></i>
                            </div>
                            <h4 class="font-bold text-slate-900 dark:text-white mb-2 text-base" data-en="Software Implementation" data-ar="تنفيذ البرمجيات">Software Implementation</h4>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed" data-en="Building integrated in-house applications and deploying research-based software systems through Neurix AI Tech." data-ar="بناء التطبيقات البرمجية المتكاملة وتطوير الأنظمة القائمة على الأبحاث من خلال تقنية نيوركس AI.">
                                Building integrated in-house applications and deploying research-based software systems through Neurix AI Tech.
                            </p>
                        </div>
                    }
                </div>
            </div>

            @* Right Side (45% space - lg:col-span-5) - Overlapping premium cards *@
            <div class="lg:col-span-5 relative w-full h-[450px] sm:h-[550px] lg:h-[620px] flex items-center justify-center">
                
                @* Top Image ("software") *@
                <div class="absolute top-0 left-0 w-[82%] aspect-[4/3] rounded-3xl overflow-hidden border border-slate-300 dark:border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.25)] transition-all duration-500 hover:scale-[1.03] hover:z-20 z-10 bg-slate-100 dark:bg-card">
                    <img src="@ethicsTopImg" alt="@ethicsTopImgAltEn" class="w-full h-full object-cover" />
                </div>
                @* Bottom Image ("research") *@
                <div class="absolute bottom-0 right-0 w-[82%] aspect-[4/3] rounded-3xl overflow-hidden border border-slate-300 dark:border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.25)] transition-all duration-500 hover:scale-[1.03] hover:z-20 z-10 bg-slate-100 dark:bg-card">
                    <img src="@ethicsBottomImg" alt="@ethicsBottomImgAltEn" class="w-full h-full object-cover" />
                </div>
            </div>
        </div>
    </div>
</section>
}
@* ═══════════════════════════════════════════════════════════
   AI & ENGINEERING SECTION
   ═══════════════════════════════════════════════════════════ *@
@if (aiSection?.IsPublished != false)
{
<section id="services" class="relative py-24 md:py-32 z-30 bg-slate-50/50 dark:bg-background/20">
    <div class="container px-6 max-w-7xl mx-auto">
        <div class="max-w-3xl mx-auto text-center mb-16">
            <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-6">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                <span data-en="@aiBadgeEn" data-ar="@aiBadgeAr">@aiBadgeEn</span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight"
                data-en="@aiTitleEn" data-ar="@aiTitleAr">@aiTitleEn</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @{ int aiIdx = 0; }
            @foreach (var item in aiItems)
            {
                var aiTheme = aiThemes[aiIdx % aiThemes.Length];
                <div class="magnetic-card card-glow-border rounded-2xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-md p-6">
                    <div class="w-10 h-10 rounded-lg @aiTheme.IconBg flex items-center justify-center @aiTheme.IconText mb-4">
                        <i data-lucide="@item.Icon" class="w-5 h-5"></i>
                    </div>
                    <h4 class="font-bold text-slate-900 dark:text-white mb-2" data-en="@item.TitleEn" data-ar="@item.TitleAr">@item.TitleEn</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-400" data-en="@item.DescEn" data-ar="@item.DescAr">@item.DescEn</p>
                </div>
                aiIdx++;
            }
        </div>
    </div>
</section>
}
@* ═══════════════════════════════════════════════════════════
   FEATURED PORTFOLIO PROJECTS (Dynamic CMS)
   ═══════════════════════════════════════════════════════════ *@
@if (Model?.FeaturedProjects != null && Model.FeaturedProjects.Any())
{
    <section id="portfolio" class="relative py-24 md:py-32 z-30 overflow-hidden">
        <div class="container px-6 max-w-7xl mx-auto">
            <div class="mb-16">
                <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-4">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                    <span data-en="@portfolioBadgeEn" data-ar="@portfolioBadgeAr">@portfolioBadgeEn</span>
                </div>
                <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight">
                    <span data-en="@portfolioTitlePrefixEn" data-ar="@portfolioTitlePrefixAr">@portfolioTitlePrefixEn</span>
                    <span class="text-gradient-brand" data-en="@portfolioTitleHighlightEn" data-ar="@portfolioTitleHighlightAr">@portfolioTitleHighlightEn</span>
                </h2>
            </div>

            <div class="@CardGridCss.ForItemCount(Model.FeaturedProjects.Count)">
                @foreach (var p in Model.FeaturedProjects)
                {
                    <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-cyan/50 hover:-translate-y-1 hover:shadow-[0_0_35px_hsl(var(--cyan)/0.2)]">
                        @if (!string.IsNullOrWhiteSpace(p.CoverImagePath))
                        {
                            <div class="relative aspect-video w-full overflow-hidden bg-muted/40">
                                <img src="@p.CoverImagePath" alt="@p.TitleEn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            </div>
                        }

                        <div class="p-7 space-y-4 flex-1 flex flex-col justify-between">
                            <div class="space-y-3">
                                @{
                                    var projectCategoryEn = PickLabel(p.Category, portfolioCategoryEn);
                                    var projectCategoryAr = PickLabel(p.Category, portfolioCategoryAr);
                                }
                                <div class="flex items-center justify-between gap-2 text-xs">
                                    @if (!string.IsNullOrWhiteSpace(projectCategoryEn) || !string.IsNullOrWhiteSpace(projectCategoryAr))
                                    {
                                        <span class="rounded-full bg-cyan/10 px-3 py-1 font-semibold text-cyan"
                                              data-en="@projectCategoryEn" data-ar="@projectCategoryAr">
                                            @projectCategoryEn
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.ClientName))
                                    {
                                        <span class="text-slate-500 dark:text-slate-400">@p.ClientName</span>
                                    }
                                </div>

                                <h3 class="font-display text-2xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cyan transition-colors">
                                    <span data-en="@p.TitleEn" data-ar="@p.TitleAr">@p.TitleEn</span>
                                </h3>

                                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed"
                                   data-en="@p.SummaryEn" data-ar="@p.SummaryAr">
                                    @p.SummaryEn
                                </p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(portfolioItemLinkEn) || !string.IsNullOrWhiteSpace(portfolioItemLinkAr))
                            {
                                <div class="pt-4 flex items-center justify-between">
                                    <a asp-controller="Home" asp-action="ProjectDetail" asp-route-slug="@p.Slug"
                                       class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan hover:underline">
                                        <span data-en="@portfolioItemLinkEn" data-ar="@portfolioItemLinkAr">@portfolioItemLinkEn</span>
                                        <i data-lucide="arrow-right" class="w-3.5 h-3.5 rtl-flip"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(portfolioBtnTextEn) || !string.IsNullOrWhiteSpace(portfolioBtnTextAr))
            {
                <div class="mt-14 flex justify-center">
                    <a href="@portfolioBtnUrl"
                       class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl text-sm font-semibold text-white bg-gradient-to-r from-azure to-deep-blue hover:brightness-90 shadow-[0_0_20px_hsl(var(--azure)/0.4)] hover:shadow-[0_0_30px_hsl(var(--azure)/0.6)] transition-all duration-300 hover:scale-105">
                        <span data-en="@portfolioBtnTextEn" data-ar="@portfolioBtnTextAr">@portfolioBtnTextEn</span>
                        <i data-lucide="arrow-right" class="w-4 h-4 rtl-flip"></i>
                    </a>
                </div>
            }
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════
   LATEST INSIGHTS & PUBLICATIONS (Dynamic CMS)
   ═══════════════════════════════════════════════════════════ *@
@if (Model?.FeaturedPosts != null && Model.FeaturedPosts.Any())
{
    <section id="insights" class="relative py-24 md:py-32 z-30 bg-slate-50/50 dark:bg-background/20">
        <div class="container px-6 max-w-7xl mx-auto">
            <div class="mb-16">
                <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-4">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                    <span data-en="@insightsBadgeEn" data-ar="@insightsBadgeAr">@insightsBadgeEn</span>
                </div>
                <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight">
                    <span data-en="@insightsTitlePrefixEn" data-ar="@insightsTitlePrefixAr">@insightsTitlePrefixEn</span>
                    <span class="text-gradient-brand" data-en="@insightsTitleHighlightEn" data-ar="@insightsTitleHighlightAr">@insightsTitleHighlightEn</span>
                </h2>
            </div>

            <div class="@CardGridCss.ForItemCount(Model.FeaturedPosts.Count)">
                @foreach (var post in Model.FeaturedPosts)
                {
                    <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-md p-6 sm:p-7 transition-all duration-300 hover:border-cyan/50 hover:-translate-y-1 hover:shadow-[0_0_30px_hsl(var(--cyan)/0.2)]">
                        <div class="space-y-4">
                            @if (!string.IsNullOrWhiteSpace(post.CoverImagePath))
                            {
                                <div class="relative aspect-video rounded-2xl overflow-hidden bg-muted/40 mb-4">
                                    <img src="@post.CoverImagePath" alt="@post.TitleEn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                </div>
                            }

                            @{
                                var postCategoryEn = PickLabel(post.Category, insightsCategoryEn);
                                var postCategoryAr = PickLabel(post.Category, insightsCategoryAr);
                                var readTimeEn = PickLabel(readTimeSuffixEn, readTimeSuffixAr);
                                var readTimeAr = PickLabel(readTimeSuffixAr, readTimeSuffixEn);
                            }
                            <div class="flex items-center justify-between gap-2 text-xs">
                                @if (!string.IsNullOrWhiteSpace(postCategoryEn) || !string.IsNullOrWhiteSpace(postCategoryAr))
                                {
                                    <span class="rounded-full bg-cyan/10 px-3 py-1 font-semibold text-cyan"
                                          data-en="@postCategoryEn" data-ar="@postCategoryAr">
                                        @postCategoryEn
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(readTimeEn))
                                {
                                    <span class="text-slate-500 dark:text-slate-400"
                                          data-en="@post.ReadTimeMinutes @readTimeEn" data-ar="@post.ReadTimeMinutes @readTimeAr">
                                        @post.ReadTimeMinutes @readTimeEn
                                    </span>
                                }
                            </div>

                            <h3 class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cyan transition-colors line-clamp-2">
                                <span data-en="@post.TitleEn" data-ar="@post.TitleAr">@post.TitleEn</span>
                            </h3>

                            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3"
                               data-en="@post.SummaryEn" data-ar="@post.SummaryAr">
                                @post.SummaryEn
                            </p>
                        </div>

                        <div class="pt-6 mt-6 border-t border-slate-200 dark:border-white/10 flex items-center justify-between">
                            @{
                                var publishedOn = post.PublishedAtUtc?.ToString("MMM dd, yyyy");
                                var publishedEn = publishedOn ?? PickLabel(undatedLabelEn, undatedLabelAr);
                                var publishedAr = publishedOn ?? PickLabel(undatedLabelAr, undatedLabelEn);
                            }
                            <span class="text-xs text-slate-500 dark:text-slate-400"
                                  data-en="@publishedEn" data-ar="@publishedAr">
                                @publishedEn
                            </span>

                            @if (!string.IsNullOrWhiteSpace(insightsItemLinkEn) || !string.IsNullOrWhiteSpace(insightsItemLinkAr))
                            {
                                <a asp-controller="Home" asp-action="InsightDetail" asp-route-slug="@post.Slug"
                                   class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan hover:underline">
                                    <span data-en="@insightsItemLinkEn" data-ar="@insightsItemLinkAr">@insightsItemLinkEn</span>
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 rtl-flip"></i>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(insightsBtnTextEn) || !string.IsNullOrWhiteSpace(insightsBtnTextAr))
            {
                <div class="mt-14 flex justify-center">
                    <a href="@insightsBtnUrl"
                       class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl text-sm font-semibold text-white bg-gradient-to-r from-azure to-deep-blue hover:brightness-90 shadow-[0_0_20px_hsl(var(--azure)/0.4)] hover:shadow-[0_0_30px_hsl(var(--azure)/0.6)] transition-all duration-300 hover:scale-105">
                        <span data-en="@insightsBtnTextEn" data-ar="@insightsBtnTextAr">@insightsBtnTextEn</span>
                        <i data-lucide="arrow-right" class="w-4 h-4 rtl-flip"></i>
                    </a>
                </div>
            }
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════
   CLIENT TESTIMONIALS & ENDORSEMENTS (Dynamic CMS)
   ═══════════════════════════════════════════════════════════ *@
@if (Model?.Testimonials != null && Model.Testimonials.Any())
{
    <section id="testimonials" class="relative py-24 md:py-32 z-30">
        <div class="container px-6 max-w-7xl mx-auto">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-6">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
                    <span data-en="@testimonialsBadgeEn" data-ar="@testimonialsBadgeAr">@testimonialsBadgeEn</span>
                </div>
                <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight mb-4">
                    <span data-en="@testimonialsTitlePrefixEn" data-ar="@testimonialsTitlePrefixAr">@testimonialsTitlePrefixEn</span>
                    @if (!string.IsNullOrWhiteSpace(testimonialsTitleHighlightEn) || !string.IsNullOrWhiteSpace(testimonialsTitleHighlightAr))
                    {
                        <span class="text-gradient-brand" data-en="@testimonialsTitleHighlightEn" data-ar="@testimonialsTitleHighlightAr">@testimonialsTitleHighlightEn</span>
                    }
                </h2>
                <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300"
                   data-en="@testimonialsSubtitleEn"
                   data-ar="@testimonialsSubtitleAr">
                    @testimonialsSubtitleEn
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @foreach (var t in Model.Testimonials)
                {
                    <div class="relative flex flex-col justify-between rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-md p-7 md:p-8 transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_30px_hsl(var(--cyan)/0.15)]">
                        <div class="space-y-4">
                            <div class="flex items-center gap-1 text-amber-400">
                                @for (int i = 0; i < t.Rating; i++)
                                {
                                    <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                                }
                            </div>

                            <blockquote class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed italic"
                                        data-en="\"@t.QuoteEn\""
                                        data-ar="\"@t.QuoteAr\"">
                                "@t.QuoteEn"
                            </blockquote>
                        </div>

                        <div class="flex items-center gap-3.5 pt-6 mt-6 border-t border-slate-200 dark:border-white/10">
                            @if (!string.IsNullOrWhiteSpace(t.AuthorPhotoPath))
                            {
                                <img src="@t.AuthorPhotoPath" alt="@t.AuthorNameEn" class="w-11 h-11 rounded-full object-cover border border-slate-300 dark:border-white/10" />
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-full bg-cyan/10 border border-cyan/30 flex items-center justify-center text-cyan font-bold text-xs">
                                    @t.AuthorNameEn.Substring(0, Math.Min(2, t.AuthorNameEn.Length)).ToUpper()
                                </div>
                            }

                            <div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white"
                                    data-en="@t.AuthorNameEn" data-ar="@t.AuthorNameAr">
                                    @t.AuthorNameEn
                                </h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400"
                                   data-en="@(t.AuthorTitleEn ?? t.CompanyName)"
                                   data-ar="@(t.AuthorTitleAr ?? t.CompanyName)">
                                    @(t.AuthorTitleEn ?? t.CompanyName)
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════
   CALL TO ACTION BANNER (#cta)
   ═══════════════════════════════════════════════════════════ *@
@if (cta?.IsPublished != false)
{
<section id="cta" class="relative py-28 md:py-36 z-30 overflow-hidden">

    <!-- Background image, full-width -->
    <img src="@ctaBgImg" alt="" aria-hidden="true"
         class="absolute inset-0 w-full h-full object-cover opacity-[0.07] dark:opacity-[0.12] z-0 pointer-events-none" />

    <!-- Ambient glows -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
        <!-- Top-right corner bleeding gradient -->
        <div class="absolute top-0 right-0 translate-x-1/3 -translate-y-1/3 w-[800px] h-[800px] bg-gradient-to-br from-cyan/25 to-azure/5 dark:from-cyan/20 dark:to-azure/5 rounded-full blur-[140px]"></div>
        <!-- Bottom-left corner bleeding gradient -->
        <div class="absolute bottom-0 left-0 -translate-x-1/3 translate-y-1/3 w-[800px] h-[800px] bg-gradient-to-tr from-azure/25 to-cyan/5 dark:from-azure/20 dark:to-cyan/5 rounded-full blur-[140px]"></div>
    </div>

    <!-- Content -->
    <div class="container relative z-10 px-6 max-w-4xl mx-auto text-center">

        <!-- Eyebrow badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-8 animate-fade-in-up">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse"></span>
            <span data-en="@ctaBadgeEn" data-ar="@ctaBadgeAr">@ctaBadgeEn</span>
        </div>

        <!-- Headline -->
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-[1.1] mb-10 animate-fade-in-up"
            style="animation-delay: 100ms;">
            <span data-en="@ctaTitlePrefixEn" data-ar="@ctaTitlePrefixAr">@ctaTitlePrefixEn</span>
            <span class="text-gradient-brand" data-en="@ctaTitleHighlightEn" data-ar="@ctaTitleHighlightAr">@ctaTitleHighlightEn</span>
        </h2>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10 animate-fade-in-up"
             style="animation-delay: 200ms;">
            <a href="@ctaButtonUrl"
               class="inline-flex items-center justify-center gap-2 px-8 py-3.5 text-sm font-semibold text-white bg-gradient-to-r from-azure to-deep-blue hover:brightness-90 shadow-[0_0_20px_hsl(var(--azure)/0.4)] hover:shadow-[0_0_30px_hsl(var(--azure)/0.6)] transition-all duration-300 hover:scale-105"
               style="border-radius: 16px;"
               data-en="@ctaButtonTextEn" data-ar="@ctaButtonTextAr">
                <i data-lucide="mail" class="w-4 h-4"></i>
                @ctaButtonTextEn
            </a>
        </div>

        <!-- Contact info -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-slate-500 dark:text-slate-400 animate-fade-in-up"
             style="animation-delay: 300ms;">
            <a href="mailto:@ctaContactEmail" class="flex items-center gap-2 hover:text-cyan transition-colors">
                <i data-lucide="mail" class="w-4 h-4 text-cyan flex-shrink-0"></i>
                @ctaContactEmail
            </a>
        </div>

    </div>
</section>
}
@section Scripts {
<script>
    // ── IntersectionObserver: Division cards stagger reveal ──
    (function () {
        const cards = document.querySelectorAll('[data-animate="stagger"]');
        if (!cards.length) return;
        const obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.remove('opacity-0', 'translate-y-6');
                    entry.target.classList.add('opacity-100', 'translate-y-0');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        cards.forEach(function (c) { obs.observe(c); });
    })();

    // ── Re-init Lucide icons ──
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
}
