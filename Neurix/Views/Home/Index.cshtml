@* ═══════════════════════════════════════════════════════════
   HERO SECTION
   ═══════════════════════════════════════════════════════════ *@
<section id="hero" class="relative min-h-screen flex items-center justify-center pt-24 md:pt-32 pb-28 md:pb-36">

    @* Layer 0: base radial gradient *@
    <div class="absolute inset-0 z-0 bg-hero-radial" aria-hidden="true"></div>

    @* Layer 0: grid texture *@
    <div class="absolute inset-0 z-0 bg-grid-pattern pointer-events-none" aria-hidden="true"></div>

    @* Layer 0: focal radial glow *@
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[820px] h-[820px] max-w-[110vw] max-h-[110vw] rounded-full pointer-events-none z-0"
         style="background: radial-gradient(circle, hsl(var(--cyan) / 0.18) 0%, hsl(var(--azure) / 0.08) 35%, transparent 70%); filter: blur(20px);"
         aria-hidden="true"></div>

    @* Layer 3: content *@
    <div class="container relative z-30 text-center max-w-5xl px-5 sm:px-6">

        @* Eyebrow *@
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-slate-100/60 dark:bg-card/40 backdrop-blur-sm px-4 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 mb-10 animate-fade-in">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse"></span>
            <span data-en="@heroBadgeEn" data-ar="@heroBadgeAr">@heroBadgeEn</span>
