                        new { Bg = "bg-cyan/10", Text = "text-cyan", Shadow = "shadow-[0_0_15px_hsl(var(--cyan)/0.2)]" },
                        new { Bg = "bg-azure/10", Text = "text-azure", Shadow = "shadow-[0_0_15px_hsl(var(--azure)/0.2)]" },
                        new { Bg = "bg-cyan/10", Text = "text-cyan", Shadow = "shadow-[0_0_15px_hsl(var(--cyan)/0.2)]" },
