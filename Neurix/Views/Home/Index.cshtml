                        new { Bg = "bg-purple-500/10", Text = "text-purple-500", Shadow = "shadow-[0_0_15px_rgba(168,85,247,0.2)]" },
                        new { Bg = "bg-emerald-500/10", Text = "text-emerald-500", Shadow = "shadow-[0_0_15px_rgba(16,185,129,0.2)]" }
                    };
                    int pIdx = 0;

                    @foreach (var p in pillarItems)
