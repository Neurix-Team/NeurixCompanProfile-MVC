@model Neurix.Models.CrmLeadDetailsViewModel

<div class="max-w-5xl">

    <a asp-action="Index" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i>
        @L["Back to leads"]
    </a>

    @* ── Header ── *@
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-2">
                <h2 class="font-display text-xl font-bold tracking-tight truncate">@Model.FullName</h2>
                <partial name="_CrmLeadStatusBadge" model="Model.Status" />
            </div>
            <p class="text-sm text-muted-foreground">
                @(Model.CompanyName ?? "No company given")
                <span class="mx-1.5 text-border">·</span>
                via @Model.Source
            </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            @if (!Model.IsConverted)
            {
                <a asp-action="Convert" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-1.5 rounded-[16px] px-4 h-10 text-sm font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:shadow-[0_0_30px_hsl(var(--cyan)/0.5)] transition-all duration-300">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    @L["Convert"]
                </a>
            }

            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-flex items-center gap-1.5 rounded-xl border border-border px-4 h-10 text-sm font-medium hover:bg-muted transition-colors">
                <i data-lucide="pencil" class="w-4 h-4"></i>
                @L["Edit"]
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('@L["Delete this lead?"]');">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-rose-500/30 px-4 h-10 text-sm font-medium text-rose-500 hover:bg-rose-500/10 transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    @L["Delete"]
                </button>
            </form>
        </div>
    </div>

    @* ── Conversion outcome ── *@
    @if (Model.IsConverted)
    {
        <div class="rounded-2xl border border-violet-500/30 bg-violet-500/10 p-5 mb-6">
            <div class="flex items-start gap-3">
                <i data-lucide="user-check" class="w-4 h-4 text-violet-400 mt-0.5 shrink-0"></i>
                <div class="text-sm">
                    <p class="font-medium text-violet-400 mb-1">
                        @(Model.ConvertedAtUtc.HasValue ? L.Format("Converted on {0:dd MMM yyyy}", Model.ConvertedAtUtc.Value) : L["Converted"])
                    </p>
                    <p class="text-muted-foreground">
                        @* Name is null when the record was soft-deleted after the
                           conversion, in which case there is nothing to link to. *@
                        @if (!string.IsNullOrWhiteSpace(Model.ConvertedToContactName))
                        {
                            <text>@L["Contact"]</text>
                            <a asp-controller="CrmContacts" asp-action="Details" asp-route-id="@Model.ConvertedToContactId"
                               class="text-cyan hover:underline">@Model.ConvertedToContactName</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ConvertedToCompanyName))
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.ConvertedToContactName))
                            {
                                <span class="mx-1.5 text-border">·</span>
                            }
                            <text>@L["Company"]</text>
                            <a asp-controller="CrmCompanies" asp-action="Details" asp-route-id="@Model.ConvertedToCompanyId"
                               class="text-cyan hover:underline">@Model.ConvertedToCompanyName</a>
                        }
                        @if (string.IsNullOrWhiteSpace(Model.ConvertedToContactName)
                             && string.IsNullOrWhiteSpace(Model.ConvertedToCompanyName))
                        {
                            <text>@L["The records this lead was converted into have since been deleted."]</text>
                        }
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* ── Enquiry ── *@
        <div class="lg:col-span-2 rounded-2xl border border-border bg-card/60 p-6">
            <h3 class="font-display text-sm font-semibold mb-5">@L["Lead details"]</h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Email"]</dt>
                    <dd><a href="mailto:@Model.Email" class="text-cyan hover:underline break-all">@Model.Email</a></dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Phone"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Company"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "—" : Model.CompanyName)</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Inquiry type"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.InquiryType) ? "—" : Model.InquiryType)</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Original message"]</dt>
                    <dd class="whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Message) ? "—" : Model.Message)</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Internal notes"]</dt>
                    <dd class="whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
                </div>
            </dl>

            <div class="mt-6 pt-5 border-t border-border text-xs text-muted-foreground">
                Received @Model.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC
                @if (Model.UpdatedAtUtc.HasValue)
                {
                    <span class="mx-1.5 text-border">·</span>
                    <text>Updated @Model.UpdatedAtUtc.Value.ToString("dd MMM yyyy, HH:mm") UTC</text>
                }
                @if (Model.CapturedFromWebsiteForm)
                {
                    <span class="mx-1.5 text-border">·</span>
                    <text>@L["Captured from the website contact form"]</text>
                }
            </div>
        </div>

        @* ── Ownership ── *@
        <div class="rounded-2xl border border-border bg-card/60 p-6">
            <h3 class="font-display text-sm font-semibold mb-5">@L["Ownership"]</h3>

            <dl class="space-y-4 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Assigned to"]</dt>
                    <dd>
                        @if (string.IsNullOrWhiteSpace(Model.AssignedToUserName))
                        {
                            <span class="text-muted-foreground">@L["Unassigned —"]</span>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="text-cyan hover:underline">@L["assign someone"]</a>
                        }
                        else
                        {
                            @Model.AssignedToUserName
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Status"]</dt>
                    <dd><partial name="_CrmLeadStatusBadge" model="Model.Status" /></dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-muted-foreground mb-1">@L["Source"]</dt>
                    <dd>@Model.Source</dd>
                </div>
            </dl>
        </div>
    </div>
</div>
