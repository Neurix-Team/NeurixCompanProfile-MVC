@model Neurix.Models.CmsPageBandsIndexViewModel
@{
    ViewData["Title"] = L["Page Sections"];
    Layout = "_CmsLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight text-foreground">@L["Page Sections"]</h1>
            <p class="text-sm text-muted-foreground mt-1">@L["Every band on the pages beyond the homepage, and the copy inside it."]</p>
        </div>

        @if (Model.Companies.Count > 1)
        {
            <form asp-action="Index" method="get" class="flex items-center gap-2">
                <select name="companyId" asp-items="Model.CompanyOptions" onchange="this.form.submit()"
                        class="rounded-xl border border-border bg-background px-3.5 py-2 text-xs text-foreground focus:ring-2 focus:ring-cyan focus:outline-none"></select>
            </form>
        }
    </div>

    <!-- Alert -->
    <partial name="_CmsAlert" />

    <!-- Where the rest of each page lives -->
    <div class="rounded-xl border border-cyan/20 bg-cyan/5 p-4 flex items-start gap-3">
        <i data-lucide="info" class="w-4 h-4 text-cyan mt-0.5 flex-shrink-0"></i>
        <p class="text-xs text-muted-foreground">
            @L["The homepage is edited under Home Sections. A division page's hero title, hero subtitle and mission live under Division Pages — everything else on it is here."]
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @foreach (var pageRow in Model.Pages)
        {
            <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 space-y-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="text-sm font-semibold text-foreground">@pageRow.Label</h2>
                        <p class="text-[11px] text-muted-foreground font-mono mt-0.5">@pageRow.PublicUrl</p>
                    </div>
                    <a href="@pageRow.PublicUrl" target="_blank" rel="noopener"
                       class="rounded-lg border border-border p-2 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    </a>
                </div>

                <div class="divide-y divide-border">
                    @foreach (var band in pageRow.Bands)
                    {
                        <div class="flex items-center gap-3 py-2.5">
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-xs font-medium text-foreground">@L[band.Label]</p>
                                @if (band.SupportsItems)
                                {
                                    <p class="text-[11px] text-muted-foreground">
                                        @band.ItemCount @L[band.ItemsLabel]
                                    </p>
                                }
                            </div>

                            @if (band.Band == null)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-muted text-muted-foreground">@L["Default"]</span>
                            }
                            else if (!band.Band.IsPublished)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-500">@L["Hidden"]</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500">@L["Live"]</span>
                            }

                            <a asp-action="EditBand" asp-route-pageKey="@pageRow.PageKey" asp-route-bandKey="@band.BandKey" asp-route-companyId="@Model.SelectedCompanyId"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-[11px] font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                                <i data-lucide="pencil" class="w-3 h-3"></i> @L["Edit"]
                            </a>
                        </div>
                    }
                </div>

                @if (pageRow.HasDivisionPageRow)
                {
                    <a asp-controller="CmsDivisionPages" asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId"
                       class="inline-flex items-center gap-1.5 text-[11px] font-medium text-cyan hover:underline">
                        <i data-lucide="corner-down-right" class="w-3 h-3 dir-flip"></i>
                        @L["Hero title, subtitle and mission for this page"]
                    </a>
                }
            </div>
        }
    </div>
</div>
