@model Neurix.Models.CmsCompanyProfileFormViewModel

<div class="space-y-8">
    <!-- 1. Brand Identity & URLs -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="building" class="w-5 h-5 text-cyan"></i>
            <h3 class="text-base font-bold text-foreground">@L["Brand Identity & Website URL"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- English Name -->
            <div>
                <label asp-for="NameEn" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="NameEn" id="input-name-en" oninput="updateLiveBrandPreview()" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. Neurix AI"]' />
                <span asp-validation-for="NameEn" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Arabic Name -->
            <div>
                <label asp-for="NameAr" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="NameAr" dir="rtl" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-arabic placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="مثال: نيوركس AI" />
                <span asp-validation-for="NameAr" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Slug -->
            <div>
                <label asp-for="Slug" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="Slug" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-mono placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. neurix or daleel"]' />
                <span asp-validation-for="Slug" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground mt-1">@L["Unique slug used for routing and tenant scoping."]</p>
            </div>

            <!-- Official Website URL -->
            <div>
                <label asp-for="Website" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <div class="relative">
                    <input asp-for="Website" class="w-full rounded-xl bg-background/60 border border-border pl-4 pr-10 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="https://neurix.uk" />
                    <i data-lucide="globe" class="w-4 h-4 text-muted-foreground absolute right-3.5 top-3 pointer-events-none"></i>
                </div>
                <span asp-validation-for="Website" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground mt-1">@L["Primary public domain or landing page URL."]</p>
            </div>
        </div>
    </div>

    <!-- 2. Visual Assets (Logo & Favicon) -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="image" class="w-5 h-5 text-azure"></i>
            <h3 class="text-base font-bold text-foreground">@L["Brand Logo & Favicon Assets"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Brand Logo -->
            <div class="p-4 rounded-xl bg-background/40 border border-border/80 space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-foreground flex items-center gap-1.5">
                        <i data-lucide="award" class="w-3.5 h-3.5 text-cyan"></i>
                        @L["Brand Logo"]
                    </label>
                    @if (!string.IsNullOrWhiteSpace(Model?.LogoPath))
                    {
                        <span class="text-[11px] text-cyan font-medium">@L["Active"]</span>
                    }
                </div>

                <div class="flex items-start gap-4">
                    <div id="logo-preview-box" class="w-16 h-16 rounded-2xl bg-card border border-border flex items-center justify-center overflow-hidden shrink-0 p-2 shadow-inner">
                        @if (!string.IsNullOrWhiteSpace(Model?.LogoPath))
                        {
                            <img id="logo-preview-img" src="@Model.LogoPath" alt='@L["Logo preview"]' class="w-full h-full object-contain" />
                        }
                        else
                        {
                            <i id="logo-preview-placeholder" data-lucide="image" class="w-6 h-6 text-muted-foreground/60"></i>
                            <img id="logo-preview-img" src="" alt='@L["Logo preview"]' class="w-full h-full object-contain hidden" />
                        }
                    </div>

                    <div class="flex-1 space-y-2">
                        <input asp-for="LogoFile" type="file" accept=".png,.jpg,.jpeg,.webp,.svg"
                               onchange="previewLogoFile(this)"
                               class="w-full text-xs text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-cyan/10 file:text-cyan hover:file:bg-cyan/20 cursor-pointer" />
                        <input asp-for="LogoPath" id="logo-path-input" oninput="previewLogoFromInput(this.value)"
                               class="w-full rounded-xl bg-background/80 border border-border px-3 py-1.5 text-xs text-foreground font-mono placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30"
                               placeholder='@L["Or enter path / URL (/images/neurix-logo.png)"]' />
                    </div>
                </div>
                <span asp-validation-for="LogoFile" class="text-xs text-rose-500 mt-1 block"></span>
                <span asp-validation-for="LogoPath" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground">@L["Recommended: Transparent PNG or SVG (approx. 200x200px or wide mark)."]</p>
            </div>

            <!-- Website Favicon -->
            <div class="p-4 rounded-xl bg-background/40 border border-border/80 space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-foreground flex items-center gap-1.5">
                        <i data-lucide="bookmark" class="w-3.5 h-3.5 text-azure"></i>
                        @L["Browser Favicon"]
                    </label>
                    @if (!string.IsNullOrWhiteSpace(Model?.FaviconPath))
                    {
                        <span class="text-[11px] text-azure font-medium">@L["Active"]</span>
                    }
                </div>

                <div class="flex items-start gap-4">
                    <div id="favicon-preview-box" class="w-16 h-16 rounded-2xl bg-card border border-border flex flex-col items-center justify-center overflow-hidden shrink-0 p-2 shadow-inner relative">
                        <div class="absolute top-1 left-1.5 text-[9px] uppercase tracking-wider text-muted-foreground/60 font-mono font-bold">@L["Tab"]</div>
                        @if (!string.IsNullOrWhiteSpace(Model?.FaviconPath))
                        {
                            <img id="favicon-preview-img" src="@Model.FaviconPath" alt='@L["Favicon preview"]' class="w-8 h-8 object-contain mt-2" />
                        }
                        else
                        {
                            <i id="favicon-preview-placeholder" data-lucide="globe" class="w-6 h-6 text-muted-foreground/60 mt-2"></i>
                            <img id="favicon-preview-img" src="" alt='@L["Favicon preview"]' class="w-8 h-8 object-contain mt-2 hidden" />
                        }
                    </div>

                    <div class="flex-1 space-y-2">
                        <input asp-for="FaviconFile" type="file" accept=".png,.ico,.svg,.webp,.jpg"
                               onchange="previewFaviconFile(this)"
                               class="w-full text-xs text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-azure/10 file:text-azure hover:file:bg-azure/20 cursor-pointer" />
                        <input asp-for="FaviconPath" id="favicon-path-input" oninput="previewFaviconFromInput(this.value)"
                               class="w-full rounded-xl bg-background/80 border border-border px-3 py-1.5 text-xs text-foreground font-mono placeholder-muted-foreground outline-none transition-all focus:border-azure/70 focus:ring-1 focus:ring-azure/30"
                               placeholder='@L["Or enter path / URL (/images/favicon.svg)"]' />
                    </div>
                </div>
                <span asp-validation-for="FaviconFile" class="text-xs text-rose-500 mt-1 block"></span>
                <span asp-validation-for="FaviconPath" class="text-xs text-rose-500 mt-1 block"></span>
                <p class="text-[11px] text-muted-foreground">@L["Recommended: SVG or ICO (e.g. 32x32px or 64x64px vector)."]</p>
            </div>
        </div>
    </div>

    <!-- 3. Color Palette & Live Brand Preview -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="palette" class="w-5 h-5 text-cyan"></i>
            <h3 class="text-base font-bold text-foreground">@L["Brand Color Palette & Styling"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Primary Color -->
            <div class="p-4 rounded-xl bg-background/40 border border-border/80 space-y-3">
                <label asp-for="PrimaryColor" class="block text-xs font-bold text-foreground"></label>
                <div class="flex items-center gap-3">
                    <input type="color" id="primary-color-picker"
                           value="@(string.IsNullOrWhiteSpace(Model?.PrimaryColor) ? "#00C2D4" : Model.PrimaryColor)"
                           oninput="syncPrimaryColor(this.value)"
                           class="w-12 h-11 rounded-xl cursor-pointer border border-border bg-card p-1 shadow-sm shrink-0" />
                    
                    <div class="flex-1">
                        <input asp-for="PrimaryColor" id="primary-color-input"
                               value="@(string.IsNullOrWhiteSpace(Model?.PrimaryColor) ? "#00C2D4" : Model.PrimaryColor)"
                               oninput="syncPrimaryFromText(this.value)"
                               class="w-full rounded-xl bg-background/80 border border-border px-3 py-2 text-sm font-mono text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 uppercase"
                               placeholder="#00C2D4" maxlength="9" />
                    </div>
                </div>
                <span asp-validation-for="PrimaryColor" class="text-xs text-rose-500 mt-1 block"></span>

                <!-- Quick Presets -->
                <div class="flex items-center gap-1.5 pt-1">
                    <span class="text-[10px] text-muted-foreground font-semibold uppercase">@L["Presets:"]</span>
                    <button type="button" onclick="setPrimaryColorPreset('#00C2D4')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #00C2D4;" title='@L["Neurix Cyan (#00C2D4)"]'></button>
                    <button type="button" onclick="setPrimaryColorPreset('#0077FE')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #0077FE;" title='@L["Azure (#0077FE)"]'></button>
                    <button type="button" onclick="setPrimaryColorPreset('#5B5FEF')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #5B5FEF;" title='@L["Indigo (#5B5FEF)"]'></button>
                    <button type="button" onclick="setPrimaryColorPreset('#10B981')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #10B981;" title='@L["Emerald (#10B981)"]'></button>
                    <button type="button" onclick="setPrimaryColorPreset('#F97316')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #F97316;" title='@L["Orange (#F97316)"]'></button>
                </div>
            </div>

            <!-- Accent Color -->
            <div class="p-4 rounded-xl bg-background/40 border border-border/80 space-y-3">
                <label asp-for="AccentColor" class="block text-xs font-bold text-foreground"></label>
                <div class="flex items-center gap-3">
                    <input type="color" id="accent-color-picker"
                           value="@(string.IsNullOrWhiteSpace(Model?.AccentColor) ? "#5B5FEF" : Model.AccentColor)"
                           oninput="syncAccentColor(this.value)"
                           class="w-12 h-11 rounded-xl cursor-pointer border border-border bg-card p-1 shadow-sm shrink-0" />
                    
                    <div class="flex-1">
                        <input asp-for="AccentColor" id="accent-color-input"
                               value="@(string.IsNullOrWhiteSpace(Model?.AccentColor) ? "#5B5FEF" : Model.AccentColor)"
                               oninput="syncAccentFromText(this.value)"
                               class="w-full rounded-xl bg-background/80 border border-border px-3 py-2 text-sm font-mono text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 uppercase"
                               placeholder="#5B5FEF" maxlength="9" />
                    </div>
                </div>
                <span asp-validation-for="AccentColor" class="text-xs text-rose-500 mt-1 block"></span>

                <!-- Quick Presets -->
                <div class="flex items-center gap-1.5 pt-1">
                    <span class="text-[10px] text-muted-foreground font-semibold uppercase">@L["Presets:"]</span>
                    <button type="button" onclick="setAccentColorPreset('#5B5FEF')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #5B5FEF;" title='@L["Indigo (#5B5FEF)"]'></button>
                    <button type="button" onclick="setAccentColorPreset('#00C2D4')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #00C2D4;" title='@L["Cyan (#00C2D4)"]'></button>
                    <button type="button" onclick="setAccentColorPreset('#8B5CF6')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #8B5CF6;" title='@L["Purple (#8B5CF6)"]'></button>
                    <button type="button" onclick="setAccentColorPreset('#EC4899')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #EC4899;" title='@L["Pink (#EC4899)"]'></button>
                    <button type="button" onclick="setAccentColorPreset('#06B6D4')" class="w-5 h-5 rounded-full border border-white/20 transition-transform hover:scale-110 shadow-sm" style="background-color: #06B6D4;" title='@L["Sky (#06B6D4)"]'></button>
                </div>
            </div>
        </div>

        <!-- Live Brand Visualizer Banner -->
        <div class="p-5 rounded-2xl border border-border bg-gradient-to-br from-card/80 to-background/90 backdrop-blur-xl relative overflow-hidden shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span id="preview-brand-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-wide border shadow-sm transition-all"
                              style="background-color: @(Model?.PrimaryColor ?? "#00C2D4")1A; color: @(Model?.PrimaryColor ?? "#00C2D4"); border-color: @(Model?.PrimaryColor ?? "#00C2D4")40;">
                            @L["Live Color Preview"]
                        </span>
                        <span id="preview-gradient-bar" class="h-2 w-16 rounded-full transition-all"
                              style="background: linear-gradient(90deg, @(Model?.PrimaryColor ?? "#00C2D4"), @(Model?.AccentColor ?? "#5B5FEF"));"></span>
                    </div>
                    <h4 id="preview-brand-name" class="text-base font-bold text-foreground">@(string.IsNullOrWhiteSpace(Model?.NameEn) ? "Neurix AI" : Model.NameEn)</h4>
                    <p class="text-xs text-muted-foreground">@L["Buttons and gradients dynamically adapt to your selected primary and accent colors."]</p>
                </div>

                <div class="flex items-center gap-3">
                    <div id="preview-btn-mock" class="px-4 py-2 rounded-xl text-xs font-bold text-white shadow-lg transition-all flex items-center gap-2 cursor-default"
                         style="background: linear-gradient(135deg, @(Model?.PrimaryColor ?? "#00C2D4"), @(Model?.AccentColor ?? "#5B5FEF")); box-shadow: 0 0 20px @(Model?.PrimaryColor ?? "#00C2D4")50;">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                        @L["Action Button"]
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Taglines & Short Descriptions (Bilingual) -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="sparkles" class="w-5 h-5 text-azure"></i>
            <h3 class="text-base font-bold text-foreground">@L["Tagline & Summary (Bilingual)"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Tagline English -->
            <div>
                <label asp-for="TaglineEn" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="TaglineEn" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder='@L["e.g. Building Human-Centered AI for Tomorrow"]' />
                <span asp-validation-for="TaglineEn" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Tagline Arabic -->
            <div>
                <label asp-for="TaglineAr" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="TaglineAr" dir="rtl" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-arabic placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="مثال: نصنع في نيوركس AI تجارب رقمية أذكى لمستقبلنا" />
                <span asp-validation-for="TaglineAr" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Short Description English -->
            <div>
                <label asp-for="ShortDescriptionEn" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <textarea asp-for="ShortDescriptionEn" rows="3" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 resize-none"></textarea>
                <span asp-validation-for="ShortDescriptionEn" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Short Description Arabic -->
            <div>
                <label asp-for="ShortDescriptionAr" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <textarea asp-for="ShortDescriptionAr" dir="rtl" rows="3" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-arabic placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 resize-none"></textarea>
                <span asp-validation-for="ShortDescriptionAr" class="text-xs text-rose-500 mt-1 block"></span>
            </div>
        </div>
    </div>

    <!-- 5. Full Descriptions -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="file-text" class="w-5 h-5 text-indigo-400"></i>
            <h3 class="text-base font-bold text-foreground">@L["Detailed Description (Bilingual)"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Full Description English -->
            <div>
                <label asp-for="DescriptionEn" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <textarea asp-for="DescriptionEn" rows="6" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 resize-y"></textarea>
                <span asp-validation-for="DescriptionEn" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Full Description Arabic -->
            <div>
                <label asp-for="DescriptionAr" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <textarea asp-for="DescriptionAr" dir="rtl" rows="6" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-arabic placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30 resize-y"></textarea>
                <span asp-validation-for="DescriptionAr" class="text-xs text-rose-500 mt-1 block"></span>
            </div>
        </div>
    </div>

    <!-- 6. Contact & Location Info -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 space-y-6">
        <div class="flex items-center gap-2 border-b border-border pb-3">
            <i data-lucide="map-pin" class="w-5 h-5 text-emerald-400"></i>
            <h3 class="text-base font-bold text-foreground">@L["Contact & Location Information"]</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="Email" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="e.g. contact@neurix.ai" />
                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Phone -->
            <div>
                <label asp-for="Phone" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="Phone" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="e.g. +1 (302) 602 4695" />
                <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Address English -->
            <div>
                <label asp-for="AddressEn" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="AddressEn" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="8th Floor, 98 Hassan El Maamoun St, Cairo, Egypt" />
                <span asp-validation-for="AddressEn" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <!-- Address Arabic -->
            <div>
                <label asp-for="AddressAr" class="block text-xs font-semibold text-foreground/80 mb-2"></label>
                <input asp-for="AddressAr" dir="rtl" class="w-full rounded-xl bg-background/60 border border-border px-4 py-2.5 text-sm text-foreground font-arabic placeholder-muted-foreground outline-none transition-all focus:border-cyan/70 focus:ring-1 focus:ring-cyan/30" placeholder="الدور الثامن، 98 شارع حسن المأمون، القاهرة، مصر" />
                <span asp-validation-for="AddressAr" class="text-xs text-rose-500 mt-1 block"></span>
            </div>
        </div>
    </div>

    <!-- 7. Publication Settings -->
    <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 flex items-center justify-between gap-4">
        <div>
            <h4 class="text-sm font-bold text-foreground">@L["Publication Status"]</h4>
            <p class="text-xs text-muted-foreground mt-0.5">@L["When published, this profile and its associated content become accessible on the public website."]</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" asp-for="IsPublished" class="sr-only peer" />
            <div class="w-11 h-6 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan"></div>
        </label>
    </div>
</div>

<script>
    // Live logo preview from file upload
    function previewLogoFile(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.getElementById('logo-preview-img');
                var placeholder = document.getElementById('logo-preview-placeholder');
                if (img) {
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                }
                if (placeholder) {
                    placeholder.classList.add('hidden');
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewLogoFromInput(val) {
        var img = document.getElementById('logo-preview-img');
        var placeholder = document.getElementById('logo-preview-placeholder');
        if (val && val.trim().length > 0) {
            if (img) {
                img.src = val.trim();
                img.classList.remove('hidden');
            }
            if (placeholder) {
                placeholder.classList.add('hidden');
            }
        }
    }

    // Live favicon preview from file upload
    function previewFaviconFile(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.getElementById('favicon-preview-img');
                var placeholder = document.getElementById('favicon-preview-placeholder');
                if (img) {
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                }
                if (placeholder) {
                    placeholder.classList.add('hidden');
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewFaviconFromInput(val) {
        var img = document.getElementById('favicon-preview-img');
        var placeholder = document.getElementById('favicon-preview-placeholder');
        if (val && val.trim().length > 0) {
            if (img) {
                img.src = val.trim();
                img.classList.remove('hidden');
            }
            if (placeholder) {
                placeholder.classList.add('hidden');
            }
        }
    }

    // Color pickers synchronization
    function syncPrimaryColor(hex) {
        var input = document.getElementById('primary-color-input');
        if (input) input.value = hex.toUpperCase();
        updateLiveBrandPreview();
    }

    function syncPrimaryFromText(hex) {
        if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
            var picker = document.getElementById('primary-color-picker');
            if (picker) picker.value = hex;
        }
        updateLiveBrandPreview();
    }

    function setPrimaryColorPreset(hex) {
        var picker = document.getElementById('primary-color-picker');
        var input = document.getElementById('primary-color-input');
        if (picker) picker.value = hex;
        if (input) input.value = hex.toUpperCase();
        updateLiveBrandPreview();
    }

    function syncAccentColor(hex) {
        var input = document.getElementById('accent-color-input');
        if (input) input.value = hex.toUpperCase();
        updateLiveBrandPreview();
    }

    function syncAccentFromText(hex) {
        if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
            var picker = document.getElementById('accent-color-picker');
            if (picker) picker.value = hex;
        }
        updateLiveBrandPreview();
    }

    function setAccentColorPreset(hex) {
        var picker = document.getElementById('accent-color-picker');
        var input = document.getElementById('accent-color-input');
        if (picker) picker.value = hex;
        if (input) input.value = hex.toUpperCase();
        updateLiveBrandPreview();
    }

    function updateLiveBrandPreview() {
        var pInput = document.getElementById('primary-color-input');
        var aInput = document.getElementById('accent-color-input');
        var nameInput = document.getElementById('input-name-en');

        var primary = (pInput && pInput.value) ? pInput.value : '#00C2D4';
        var accent = (aInput && aInput.value) ? aInput.value : '#5B5FEF';
        var name = (nameInput && nameInput.value.trim()) ? nameInput.value.trim() : 'Neurix AI';

        var badge = document.getElementById('preview-brand-badge');
        if (badge) {
            badge.style.backgroundColor = primary + '1A';
            badge.style.color = primary;
            badge.style.borderColor = primary + '40';
        }

        var bar = document.getElementById('preview-gradient-bar');
        if (bar) {
            bar.style.background = 'linear-gradient(90deg, ' + primary + ', ' + accent + ')';
        }

        var btn = document.getElementById('preview-btn-mock');
        if (btn) {
            btn.style.background = 'linear-gradient(135deg, ' + primary + ', ' + accent + ')';
            btn.style.boxShadow = '0 0 20px ' + primary + '50';
        }

        var nameHeading = document.getElementById('preview-brand-name');
        if (nameHeading) {
            nameHeading.textContent = name;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        updateLiveBrandPreview();
    });
</script>
