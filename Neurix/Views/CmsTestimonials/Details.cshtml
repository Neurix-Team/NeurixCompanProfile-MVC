@model Neurix.Models.CmsTestimonialDetailsViewModel
@{
    ViewData["Title"] = $"Testimonial — {Model.Testimonial.AuthorNameEn}";
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@Model.Testimonial.AuthorNameEn</h1>
            <p class="text-sm text-muted-foreground" dir="rtl">@Model.Testimonial.AuthorNameAr</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Testimonial.Id" class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors">
                <i data-lucide="edit-3" class="w-4 h-4"></i> @L["Edit"]
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back"]
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.Testimonial.AuthorPhotoPath))
                {
                    <img src="@Model.Testimonial.AuthorPhotoPath" alt="@Model.Testimonial.AuthorNameEn" class="w-14 h-14 rounded-full object-cover border border-border" />
                }
                <div>
                    <h3 class="font-bold text-foreground">@Model.Testimonial.AuthorNameEn</h3>
                    <p class="text-xs text-muted-foreground">@(Model.Testimonial.AuthorTitleEn ?? Model.Testimonial.CompanyName)</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <partial name="_CmsStatusBadge" model="Model.Testimonial.IsPublished" />
                @if (Model.Testimonial.IsFeatured)
                {
                    <span class="text-xs font-medium text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded">@L["Featured"]</span>
                }
            </div>
        </div>

        <div class="flex items-center gap-1 text-amber-400">
            @for (int i = 0; i < Model.Testimonial.Rating; i++)
            {
                <i data-lucide="star" class="w-4 h-4 fill-current"></i>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border">
            <div class="space-y-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">@L["English Quote"]</h4>
                <blockquote class="text-sm text-foreground italic leading-relaxed">
                    "@Model.Testimonial.QuoteEn"
                </blockquote>
            </div>

            <div class="space-y-2" dir="rtl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">نص الاقتباس بالعربية</h4>
                <blockquote class="text-sm text-foreground italic leading-relaxed">
                    "@Model.Testimonial.QuoteAr"
                </blockquote>
            </div>
        </div>
    </div>

</div>
