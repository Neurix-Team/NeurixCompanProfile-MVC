@model Neurix.Models.CmsTestimonialFormViewModel

<div class="space-y-6">

    @* Brand profile *@
    <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
        <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
            <i data-lucide="building" class="w-4 h-4 text-cyan"></i>
            @L["Brand Assignment"]
        </h3>

        <div>
            <label asp-for="CompanyProfileId" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
            <select asp-for="CompanyProfileId" asp-items="Model.CompanyOptions"
                    class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none"></select>
            <span asp-validation-for="CompanyProfileId" class="text-xs text-rose-500"></span>
        </div>
    </div>

    @* Author Details *@
    <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
        <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4 text-cyan"></i>
            @L["Author & Organization"]
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="NameEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="NameEn" placeholder='@L["e.g. Dr. Ahmed Mansour"]'
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="NameEn" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="NameAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="NameAr" dir="rtl" placeholder="مثال: د. أحمد منصور"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="NameAr" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="TitleEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="TitleEn" placeholder='@L["e.g. Dean of Engineering"]'
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="TitleEn" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="TitleAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="TitleAr" dir="rtl" placeholder="مثال: عميد كلية الهندسة"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="TitleAr" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div>
            <label asp-for="CompanyName" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
            <input asp-for="CompanyName" placeholder='@L["e.g. Assiut University or Global Digital Consortium"]'
                   class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
            <span asp-validation-for="CompanyName" class="text-xs text-rose-500"></span>
        </div>
    </div>

    @* Quote *@
    <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
        <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
            <i data-lucide="message-square" class="w-4 h-4 text-cyan"></i>
            @L["Endorsement Quote"]
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="QuoteEn" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <textarea asp-for="QuoteEn" rows="4" placeholder='@L["Quote in English..."]'
                          class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none"></textarea>
                <span asp-validation-for="QuoteEn" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="QuoteAr" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <textarea asp-for="QuoteAr" rows="4" dir="rtl" placeholder="نص الاقتباس بالعربية..."
                          class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none"></textarea>
                <span asp-validation-for="QuoteAr" class="text-xs text-rose-500"></span>
            </div>
        </div>
    </div>

    @* Photo & Settings *@
    <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
        <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
            <i data-lucide="sliders" class="w-4 h-4 text-cyan"></i>
            @L["Rating & Promotion"]
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="AuthorPhotoFile" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="AuthorPhotoFile" type="file" accept="image/*"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-sm file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:bg-cyan/10 file:text-cyan hover:file:bg-cyan/20 focus:outline-none" />
                <span asp-validation-for="AuthorPhotoFile" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="AuthorPhotoPath" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="AuthorPhotoPath" placeholder="/uploads/testimonials/author.jpg"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="AuthorPhotoPath" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="Rating" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="Rating" type="number" min="1" max="5"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="Rating" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="DisplayOrder" class="block text-xs font-medium text-muted-foreground mb-1.5"></label>
                <input asp-for="DisplayOrder" type="number"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none" />
                <span asp-validation-for="DisplayOrder" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-6 pt-2">
            <div class="flex items-center gap-3">
                <input asp-for="IsPublished" type="checkbox"
                       class="w-4 h-4 rounded border-border text-cyan focus:ring-cyan" />
                <label asp-for="IsPublished" class="text-sm font-medium text-foreground"></label>
            </div>

            <div class="flex items-center gap-3">
                <input asp-for="IsFeatured" type="checkbox"
                       class="w-4 h-4 rounded border-border text-cyan focus:ring-cyan" />
                <label asp-for="IsFeatured" class="text-sm font-medium text-foreground"></label>
            </div>
        </div>
    </div>

</div>
