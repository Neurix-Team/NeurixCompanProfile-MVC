@model Neurix.Models.CmsServiceListViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = "Services & Capabilities";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold font-display tracking-tight text-foreground">@L["Services & Capabilities"]</h2>
            <p class="text-sm text-muted-foreground mt-1">
                @L["Manage the public services, research domains, and core capabilities displayed across brand profiles."]
            </p>
        </div>
        <div>
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId" class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:shadow-[0_0_30px_hsl(var(--azure)/0.6)] hover:scale-105 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add Service"]
            </a>
        </div>
    </div>

    @if (Model.Companies.Count > 1)
    {
        <!-- Company Filter Bar -->
        <div class="flex flex-wrap items-center gap-2 pb-2 border-b border-border">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mr-2">@L["Brand:"]</span>
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-colors @(!Model.SelectedCompanyId.HasValue ? "bg-cyan/15 text-cyan border border-cyan/30 font-semibold" : "border border-border text-muted-foreground hover:text-foreground hover:bg-muted")">
                All Brands (@Model.Services.Count)
            </a>
            @foreach (var company in Model.Companies)
            {
                var isSelected = Model.SelectedCompanyId == company.Id;
                <a asp-action="Index" asp-route-companyId="@company.Id" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-colors @(isSelected ? "bg-cyan/15 text-cyan border border-cyan/30 font-semibold" : "border border-border text-muted-foreground hover:text-foreground hover:bg-muted")">
                    @company.NameEn
                </a>
            }
        </div>
    }

    <!-- Services Grid -->
    @if (!Model.Services.Any())
    {
        <div class="rounded-2xl border border-dashed border-border bg-card/40 p-12 text-center">
            <div class="w-12 h-12 rounded-2xl bg-muted/60 text-muted-foreground flex items-center justify-center mx-auto mb-4">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <h3 class="text-base font-bold text-foreground">@L["No services found"]</h3>
            <p class="text-xs text-muted-foreground mt-1 max-w-sm mx-auto">
                @L["No services have been configured for the selected brand yet. Click the button below to add your first service."]
            </p>
            <div class="mt-6">
                <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId" class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold text-primary-foreground bg-button-gradient">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    @L["Add Service"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var service in Model.Services)
            {
                <div class="card-glow-border rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-6 transition-all duration-300 hover:border-cyan/50 flex flex-col justify-between">
                    <div>
                        <!-- Top: Icon/Image, Brand Badge, Status Badge -->
                        <div class="flex items-start justify-between gap-3 mb-4">
                            @if (!string.IsNullOrWhiteSpace(service.ImagePath))
                            {
                                <div class="w-12 h-12 rounded-xl bg-background border border-border overflow-hidden shrink-0 p-1">
                                    <img src="@service.ImagePath" alt="@service.NameEn" class="w-full h-full object-contain" />
                                </div>
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-xl bg-cyan/10 text-cyan flex items-center justify-center border border-cyan/20 shrink-0">
                                    <i data-lucide="@(!string.IsNullOrWhiteSpace(service.IconName) ? service.IconName : "cpu")" class="w-5 h-5"></i>
                                </div>
                            }

                            <div class="flex items-center gap-1.5">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-muted text-muted-foreground">
                                    @service.CompanyNameEn
                                </span>
                                <partial name="_CmsStatusBadge" model="service.IsPublished" />
                            </div>
                        </div>

                        <!-- Name & Arabic Name -->
                        <h3 class="text-base font-bold text-foreground mb-1">@service.NameEn</h3>
                        <p class="text-xs text-muted-foreground font-arabic mb-3" dir="rtl">@service.NameAr</p>

                        <!-- Short Description -->
                        @if (!string.IsNullOrWhiteSpace(service.ShortDescriptionEn))
                        {
                            <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed mb-4">
                                @service.ShortDescriptionEn
                            </p>
                        }

                        <!-- Slug & Order -->
                        <div class="flex items-center gap-3 text-[11px] text-muted-foreground mb-2">
                            <span>@L["Slug:"] <code class="px-1.5 py-0.5 rounded bg-muted font-mono text-cyan">@service.Slug</code></span>
                            <span>@L["Order:"] <strong class="text-foreground">@service.DisplayOrder</strong></span>
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="pt-4 border-t border-border flex items-center justify-between gap-2 text-xs">
                        <a asp-action="Details" asp-route-id="@service.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                            @L["Details"]
                        </a>

                        <div class="flex items-center gap-1.5">
                            <a asp-action="Edit" asp-route-id="@service.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-cyan/30 bg-cyan/10 text-cyan hover:bg-cyan/20 font-medium transition-colors">
                                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                @L["Edit"]
                            </a>

                            <form asp-action="TogglePublish" asp-route-id="@service.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isPublished" value="@(!service.IsPublished ? "true" : "false")" />
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-colors" title='@(service.IsPublished ? L["Unpublish"] : L["Publish"])'>
                                    <i data-lucide="@(service.IsPublished ? "eye-off" : "check")" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@service.Id" method="post" class="inline" onsubmit="return confirm('@L["Are you sure you want to delete this service?"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                                <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-border text-muted-foreground hover:text-rose-400 hover:bg-rose-500/10 transition-colors" title='@L["Delete Service"]'>
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
