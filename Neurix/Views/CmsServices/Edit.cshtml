@model Neurix.Models.CmsServiceFormViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = $"Edit {Model.NameEn}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold font-display tracking-tight text-foreground">@L["Edit Service"]</h2>
            <p class="text-sm text-muted-foreground mt-1">
                @L["Updating"] <span class="text-cyan font-semibold">@Model.NameEn</span> (@Model.Slug).
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-border text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                <i data-lucide="eye" class="w-4 h-4"></i>
                @L["Details"]
            </a>
            <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-border text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i>
                @L["Back"]
            </a>
        </div>
    </div>

    <!-- Form -->
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="space-y-8">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-sm text-rose-400"></div>

        <partial name="_ServiceFields" model="Model" />

        <div class="flex items-center justify-between gap-3 pt-4 border-t border-border">
            <div>
                <!-- Soft delete -->
                <button type="button" onclick="if(confirm('@L["Are you sure you want to delete this service? This action will soft-delete the service."]')) { document.getElementById('delete-form').submit(); }" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-rose-500/30 text-rose-400 hover:bg-rose-500/10 text-xs font-semibold transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    @L["Delete Service"]
                </button>
            </div>

            <div class="flex items-center gap-3">
                <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="px-5 py-2.5 rounded-xl border border-border text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                    @L["Cancel"]
                </a>
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-semibold text-primary-foreground bg-button-gradient shadow-[0_0_20px_hsl(var(--azure)/0.35)] hover:shadow-[0_0_30px_hsl(var(--azure)/0.6)] hover:scale-105 transition-all">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    @L["Save Changes"]
                </button>
            </div>
        </div>
    </form>

    <form id="delete-form" asp-action="Delete" asp-route-id="@Model.Id" asp-route-companyId="@Model.CompanyProfileId" method="post" class="hidden">
        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
