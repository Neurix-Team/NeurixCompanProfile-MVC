@* Shared alert banner for CMS admin operations *@
@if (TempData["SuccessMessage"] is string success && !string.IsNullOrWhiteSpace(success))
{
    <div class="mb-6 flex items-start gap-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-400 backdrop-blur-md shadow-sm">
        <i data-lucide="check-circle-2" class="w-5 h-5 shrink-0 mt-0.5 text-emerald-400"></i>
        <div class="flex-1 text-sm font-medium">@success</div>
    </div>
}
@if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="mb-6 flex items-start gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-400 backdrop-blur-md shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-rose-400"></i>
        <div class="flex-1 text-sm font-medium">@error</div>
    </div>
}
