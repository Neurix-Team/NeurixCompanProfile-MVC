@model Neurix.Models.CrmDealFormViewModel
@using Neurix.DAL.Enums

@{
    const string InputCls = "w-full rounded-xl bg-background/60 border border-border px-4 h-11 text-sm outline-none transition-all duration-300 focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]";
    const string AreaCls = "w-full rounded-xl bg-background/60 border border-border px-4 py-3 text-sm outline-none transition-all duration-300 resize-y focus:border-cyan/70 focus:shadow-[0_0_0_4px_hsl(var(--cyan)/0.12)]";
    const string LabelCls = "block text-sm font-medium mb-2";
    const string ErrCls = "text-xs text-rose-500/80 mt-1.5 block font-medium";
}

<div asp-validation-summary="ModelOnly" class="mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-500 empty:hidden"></div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <div class="md:col-span-2">
        <label asp-for="Name" class="@LabelCls"></label>
        <input asp-for="Name" class="@InputCls" placeholder='@L["Website redesign — Acme Corp"]' />
        <span asp-validation-for="Name" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="CompanyId" class="@LabelCls"></label>
        <select asp-for="CompanyId" asp-items="Model.CompanyOptions" class="@InputCls">
            <option value="">@L["— Select a company —"]</option>
        </select>
        <span asp-validation-for="CompanyId" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="ContactId" class="@LabelCls"></label>
        <select asp-for="ContactId" asp-items="Model.ContactOptions" class="@InputCls">
            <option value="">@L["— No contact —"]</option>
        </select>
        <span asp-validation-for="ContactId" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="Value" class="@LabelCls"></label>
        <input asp-for="Value" type="number" step="0.01" min="0" class="@InputCls" placeholder="0.00" />
        <span asp-validation-for="Value" class="@ErrCls"></span>
    </div>

    <div>
        <label asp-for="Stage" class="@LabelCls"></label>
        <select asp-for="Stage" asp-items="Html.GetEnumSelectList<DealStage>().Select(o => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L[o.Text], o.Value))" class="@InputCls"></select>
        <span asp-validation-for="Stage" class="@ErrCls"></span>
    </div>

    <div class="md:col-span-2">
        <label asp-for="AssignedToUserId" class="@LabelCls"></label>
        <select asp-for="AssignedToUserId" asp-items="Model.AssignedToOptions" class="@InputCls">
            <option value="">@L["— Unassigned —"]</option>
        </select>
        <span asp-validation-for="AssignedToUserId" class="@ErrCls"></span>
    </div>

    <div class="md:col-span-2">
        <label asp-for="Notes" class="@LabelCls"></label>
        <textarea asp-for="Notes" rows="4" placeholder='@L["Internal notes on how this deal is progressing"]' class="@AreaCls"></textarea>
        <span asp-validation-for="Notes" class="@ErrCls"></span>
    </div>
</div>
