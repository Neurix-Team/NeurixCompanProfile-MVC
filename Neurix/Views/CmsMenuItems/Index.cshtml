@model Neurix.Models.CmsMenuItemListViewModel
@using Neurix.DAL.Models
@{
    ViewData["Title"] = L["Navigation Menus"];
    Layout = "_CmsLayout";
}

<div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-display tracking-tight text-foreground flex items-center gap-2.5">
                <i data-lucide="menu" class="w-6 h-6 text-cyan"></i>
                @L["Navigation Menus"]
            </h1>
            <p class="text-sm text-muted-foreground mt-1">
                @L["Manage custom navigation items for the website Header, Footer columns, and Bottom legal bar."]
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 rounded-xl bg-button-gradient px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-[0_0_15px_hsl(var(--cyan)/0.25)] hover:scale-[1.02] transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add Menu Item"]
            </a>
        </div>
    </div>

    <!-- Alert / Messages -->
    <partial name="_CmsAlert" />

    <!-- Filters & Placement Tabs -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 p-4 rounded-2xl border border-border bg-card/60 backdrop-blur-xl">
        <!-- Placement Filter Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0">
            <a asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId"
               class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all @(!Model.SelectedPlacement.HasValue ? "bg-cyan/15 text-cyan border border-cyan/30 shadow-sm" : "text-muted-foreground hover:text-foreground hover:bg-muted/60")">
                @L["All Items"] (@Model.MenuItems.Count)
            </a>
            <a asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId" asp-route-placement="@CmsMenuItemPlacement.Header"
               class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all @(Model.SelectedPlacement == CmsMenuItemPlacement.Header ? "bg-cyan/15 text-cyan border border-cyan/30 shadow-sm" : "text-muted-foreground hover:text-foreground hover:bg-muted/60")">
                <i data-lucide="layout-grid" class="w-3.5 h-3.5 inline mr-1"></i> @L["Header"]
            </a>
            <a asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId" asp-route-placement="@CmsMenuItemPlacement.Footer"
               class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all @(Model.SelectedPlacement == CmsMenuItemPlacement.Footer ? "bg-cyan/15 text-cyan border border-cyan/30 shadow-sm" : "text-muted-foreground hover:text-foreground hover:bg-muted/60")">
                <i data-lucide="panel-bottom" class="w-3.5 h-3.5 inline mr-1"></i> @L["Footer"]
            </a>
            <a asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId" asp-route-placement="@CmsMenuItemPlacement.Both"
               class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all @(Model.SelectedPlacement == CmsMenuItemPlacement.Both ? "bg-cyan/15 text-cyan border border-cyan/30 shadow-sm" : "text-muted-foreground hover:text-foreground hover:bg-muted/60")">
                <i data-lucide="layers" class="w-3.5 h-3.5 inline mr-1"></i> @L["Both"]
            </a>
            <a asp-action="Index" asp-route-companyId="@Model.SelectedCompanyId" asp-route-placement="@CmsMenuItemPlacement.FooterBottom"
               class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all @(Model.SelectedPlacement == CmsMenuItemPlacement.FooterBottom ? "bg-cyan/15 text-cyan border border-cyan/30 shadow-sm" : "text-muted-foreground hover:text-foreground hover:bg-muted/60")">
                <i data-lucide="shield" class="w-3.5 h-3.5 inline mr-1"></i> @L["Legal / Bottom"]
            </a>
        </div>

        <!-- Company Selector Filter -->
        @if (Model.Companies.Count > 1)
        {
            <form method="get" class="flex items-center gap-2">
                @if (Model.SelectedPlacement.HasValue)
                {
                    <input type="hidden" name="placement" value="@Model.SelectedPlacement.Value" />
                }
                <label for="company-select" class="text-xs font-medium text-muted-foreground whitespace-nowrap">@L["Profile:"]</label>
                <select id="company-select" name="companyId" onchange="this.form.submit()" class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-cyan">
                    @foreach (var opt in Model.CompanyOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </form>
        }
    </div>

    <!-- Items List Table / Empty State -->
    @if (Model.MenuItems.Count == 0)
    {
        <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl p-12 text-center space-y-4">
            <div class="mx-auto w-12 h-12 rounded-2xl bg-cyan/10 flex items-center justify-center text-cyan">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </div>
            <div>
                <h3 class="text-base font-semibold text-foreground">@L["No menu items found"]</h3>
                <p class="text-xs text-muted-foreground mt-1 max-w-sm mx-auto">
                    @L["Get started by adding custom navigation links for your website header and footer."]
                </p>
            </div>
            <a asp-action="Create" asp-route-companyId="@Model.SelectedCompanyId"
               class="inline-flex items-center gap-2 rounded-xl bg-button-gradient px-4 py-2 text-xs font-semibold text-primary-foreground">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Add First Menu Item"]
            </a>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-border bg-card/60 backdrop-blur-xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-border bg-muted/40 text-muted-foreground font-semibold uppercase tracking-wider text-[11px]">
                            <th class="py-3.5 px-4 w-12 text-center">#</th>
                            <th class="py-3.5 px-4">@L["Label (EN / AR)"]</th>
                            <th class="py-3.5 px-4">@L["Target URL"]</th>
                            <th class="py-3.5 px-4">@L["Placement"]</th>
                            <th class="py-3.5 px-4 text-center">@L["Tab"]</th>
                            <th class="py-3.5 px-4 text-center">@L["Status"]</th>
                            <th class="py-3.5 px-4 text-right">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var item in Model.MenuItems)
                        {
                            <tr class="hover:bg-muted/30 transition-colors group">
                                <td class="py-3.5 px-4 text-center font-mono text-muted-foreground">
                                    @item.DisplayOrder
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        @if (!string.IsNullOrWhiteSpace(item.IconName))
                                        {
                                            <span class="w-7 h-7 rounded-lg bg-cyan/10 text-cyan flex items-center justify-center shrink-0">
                                                <i data-lucide="@item.IconName" class="w-3.5 h-3.5"></i>
                                            </span>
                                        }
                                        <div>
                                            <div class="font-semibold text-foreground">@item.LabelEn</div>
                                            <div class="text-[11px] text-muted-foreground font-arabic" dir="rtl">@item.LabelAr</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-mono text-cyan text-[11px] bg-cyan/10 px-2 py-0.5 rounded-md">
                                        @item.Url
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    @switch (item.Placement)
                                    {
                                        case CmsMenuItemPlacement.Header:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-cyan/10 text-cyan border border-cyan/20">
                                                <i data-lucide="layout-grid" class="w-3 h-3"></i> @L["Header"]
                                            </span>
                                            break;
                                        case CmsMenuItemPlacement.Footer:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-azure/10 text-azure border border-azure/20">
                                                <i data-lucide="panel-bottom" class="w-3 h-3"></i> @L["Footer"]
                                            </span>
                                            break;
                                        case CmsMenuItemPlacement.Both:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
                                                <i data-lucide="layers" class="w-3 h-3"></i> @L["Both"]
                                            </span>
                                            break;
                                        case CmsMenuItemPlacement.FooterBottom:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                                <i data-lucide="shield" class="w-3 h-3"></i> @L["Bottom Bar"]
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (item.OpenInNewTab)
                                    {
                                        <span class="text-[11px] text-cyan" title='@L["Opens in new tab"]'>
                                            <i data-lucide="external-link" class="w-3.5 h-3.5 inline"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-foreground text-[11px]">—</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (item.IsPublished)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> @L["Live"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            @L["Draft"]
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-colors"
                                           title='@L["Edit"]'>
                                            <i data-lucide="edit-3" class="w-4 h-4"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" asp-route-companyId="@Model.SelectedCompanyId"
                                              method="post" onsubmit="return confirm('@L["Are you sure you want to delete this menu item?"]');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="p-1.5 rounded-lg text-muted-foreground hover:text-rose-500 hover:bg-rose-500/10 transition-colors"
                                                    title='@L["Delete"]'>
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
