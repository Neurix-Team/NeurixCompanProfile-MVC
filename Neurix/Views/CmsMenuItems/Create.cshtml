@model Neurix.Models.CmsMenuItemFormViewModel
@{
    ViewData["Title"] = L["Add Menu Item"];
    Layout = "_CmsLayout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan/10 text-cyan">@L["Navigation"]</span>
                <h1 class="text-2xl font-display font-bold tracking-tight text-foreground">@L["Add Menu Item"]</h1>
            </div>
            <p class="text-sm text-muted-foreground mt-1">@L["Add a new navigation link to the website Header, Footer, or Legal Bottom bar."]</p>
        </div>
        <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="inline-flex items-center gap-2 rounded-xl border border-border px-3.5 py-2 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4 dir-flip"></i> @L["Back to Menus"]
        </a>
    </div>

    <!-- Form -->
    <form asp-action="Create" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-xs text-rose-500"></div>

        <partial name="_MenuItemFields" model="Model" />

        <!-- Submit -->
        <div class="rounded-2xl border border-border bg-card/80 backdrop-blur-xl p-6 flex items-center justify-end gap-3">
            <a asp-action="Index" asp-route-companyId="@Model.CompanyProfileId" class="px-4 py-2 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
                @L["Cancel"]
            </a>
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-xs font-semibold text-primary-foreground bg-button-gradient hover:scale-[1.02] shadow-[0_0_15px_hsl(var(--cyan)/0.25)] transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                @L["Create Menu Item"]
            </button>
        </div>
    </form>
</div>
