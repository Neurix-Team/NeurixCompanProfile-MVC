@model Neurix.Models.CmsMediaAssetListViewModel
@{
    ViewData["Title"] = "Media Library";
    Layout = "_CmsLayout";
}

<div class="space-y-6">

    @* Header *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-display font-bold tracking-tight">@L["Media Library"]</h1>
            <p class="text-sm text-muted-foreground">@L["Upload, organize, and manage reusable logos, banners, team photos, and digital assets."]</p>
        </div>

        <button type="button" onclick="document.getElementById('upload-modal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors shadow-sm">
            <i data-lucide="upload-cloud" class="w-4 h-4"></i>
            @L["Upload Asset"]
        </button>
    </div>

    @* Filters *@
    <div class="flex flex-wrap items-center gap-3">
        <form method="get" class="flex flex-wrap items-center gap-3">
            @if (Model.Companies.Count > 1)
            {
                <select name="companyId" onchange="this.form.submit()"
                        class="rounded-xl border border-border bg-card px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none">
                    <option value="">@L["All Brands"]</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.SelectedCompanyId)">@c.NameEn</option>
                    }
                </select>
            }

            <select name="category" onchange="this.form.submit()"
                    class="rounded-xl border border-border bg-card px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none">
                @foreach (var cat in Model.CategoryOptions)
                {
                    <option value="@cat.Value" selected="@cat.Selected">Category: @cat.Text</option>
                }
            </select>
        </form>
    </div>

    @if (Model.Assets.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-border p-12 text-center text-muted-foreground space-y-3">
            <i data-lucide="image" class="w-10 h-10 mx-auto text-muted-foreground/50"></i>
            <p class="text-sm">@L["No media assets in this category."]</p>
            <button type="button" onclick="document.getElementById('upload-modal').classList.remove('hidden')"
                    class="inline-flex items-center gap-1.5 text-xs text-cyan hover:underline">
                <i data-lucide="upload" class="w-3.5 h-3.5"></i> @L["Upload your first asset"]
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var asset in Model.Assets)
            {
                var formattedSize = asset.FileSizeBytes > 0 ? $"{(asset.FileSizeBytes / 1024.0):0.#} KB" : "";
                var usageCount = Model.UsageCounts.TryGetValue(asset.Id, out var count) ? count : 0;
                <div class="group rounded-2xl border border-border bg-card overflow-hidden shadow-sm hover:border-cyan/50 transition-all flex flex-col justify-between">
                    <div class="relative aspect-square bg-muted/30 flex items-center justify-center overflow-hidden">
                        @if (asset.ContentType?.StartsWith("image/") == true)
                        {
                            <img src="@asset.FilePath" alt="@asset.AltTextEn" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        }
                        else
                        {
                            <i data-lucide="file" class="w-10 h-10 text-muted-foreground"></i>
                        }

                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 p-2">
                            <button type="button" onclick="copyAssetUrl('@asset.FilePath')" title='@L["Copy URL"]'
                                    class="w-8 h-8 rounded-lg bg-white/20 text-white hover:bg-white/30 backdrop-blur-md flex items-center justify-center">
                                <i data-lucide="copy" class="w-4 h-4"></i>
                            </button>
                            <button type="button"
                                    data-asset-id="@asset.Id"
                                    data-asset-name="@asset.OriginalFileName"
                                    data-asset-path="@asset.FilePath"
                                    data-asset-category="@(asset.Category ?? "General")"
                                    data-asset-size="@formattedSize"
                                    onclick="openUsagesFromButton(this)"
                                    title='@L["Check Usage"]'
                                    class="w-8 h-8 rounded-lg bg-cyan/20 text-cyan hover:bg-cyan/40 backdrop-blur-md flex items-center justify-center">
                                <i data-lucide="link" class="w-4 h-4"></i>
                            </button>
                            <button type="button"
                                    data-asset-id="@asset.Id"
                                    data-asset-name="@asset.OriginalFileName"
                                    data-asset-path="@asset.FilePath"
                                    data-asset-category="@(asset.Category ?? "General")"
                                    data-asset-size="@formattedSize"
                                    onclick="openUsagesFromButton(this)"
                                    title='@L["Delete"]'
                                    class="w-8 h-8 rounded-lg bg-rose-500/30 text-rose-300 hover:bg-rose-500/50 backdrop-blur-md flex items-center justify-center">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <div class="p-2.5 space-y-1.5">
                        <p class="text-[11px] font-semibold text-foreground truncate" title="@asset.OriginalFileName">
                            @asset.OriginalFileName
                        </p>
                        <div class="flex items-center justify-between text-[10px] text-muted-foreground">
                            <span class="truncate">@(asset.Category ?? "General")</span>
                            <span>@formattedSize</span>
                        </div>
                        <div class="pt-1 border-t border-border/50 flex items-center justify-between gap-1">
                            <button type="button"
                                    data-asset-id="@asset.Id"
                                    data-asset-name="@asset.OriginalFileName"
                                    data-asset-path="@asset.FilePath"
                                    data-asset-category="@(asset.Category ?? "General")"
                                    data-asset-size="@formattedSize"
                                    onclick="openUsagesFromButton(this)"
                                    class="inline-flex items-center gap-1 text-[10px] font-medium text-cyan hover:underline shrink-0">
                                <i data-lucide="link-2" class="w-3 h-3"></i>
                                <span>@L["Check Usage"]</span>
                            </button>
                            @if (usageCount == 0)
                            {
                                <span class="inline-flex items-center rounded-md bg-emerald-500/10 border border-emerald-500/20 px-1.5 py-0.5 text-[9px] font-medium text-emerald-400 shrink-0">
                                    @L["Unused"]
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-md bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 text-[9px] font-medium text-amber-300 shrink-0">
                                    @L.Format("Used in {0} place(s)", usageCount)
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@* Upload Modal *@
<div id="upload-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-foreground flex items-center gap-2">
                <i data-lucide="upload-cloud" class="w-5 h-5 text-cyan"></i>
                @L["Upload Media Asset"]
            </h3>
            <button type="button" onclick="document.getElementById('upload-modal').classList.add('hidden')"
                    class="text-muted-foreground hover:text-foreground">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CompanyProfileId" value="@(Model.SelectedCompanyId ?? Model.Companies.FirstOrDefault()?.Id ?? Guid.Empty)" />

            <div>
@*  This form posts CmsMediaAssetUploadViewModel but the page's model is the list
    view model, so asp-for (and therefore RequiredLabelTagHelper) cannot be used
    here. The indicator is written out by hand, reusing the same class so the
    styling stays centralised. File is [Required] on the upload view model. *@
                <label class="block text-xs font-medium text-muted-foreground mb-1.5">
                    @L["Select File"]<span class="required-indicator" aria-hidden="true" title='@L["Required"]'>*</span>
                </label>
                <input type="file" name="File" required accept=".png,.jpg,.jpeg,.webp,.svg,.ico"
                       class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-sm file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:bg-cyan/10 file:text-cyan hover:file:bg-cyan/20 focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-medium text-muted-foreground mb-1.5">@L["Category"]</label>
                <select name="Category"
                        class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-cyan focus:outline-none">
                    <option value="General">@L["General"]</option>
                    <option value="Logos">@L["Logos"]</option>
                    <option value="Team">@L["Team Photos"]</option>
                    <option value="Blog">@L["Blog Covers"]</option>
                    <option value="Projects">@L["Project Screenshots"]</option>
                    <option value="Banners">@L["Banners & Backgrounds"]</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1.5">@L["Alt Text (English)"]</label>
                    <input type="text" name="AltTextEn" placeholder='@L["Description of image..."]'
                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1.5">@L["Alt Text (Arabic)"]</label>
                    <input type="text" name="AltTextAr" dir="rtl" placeholder="وصف الصورة..."
                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs focus:ring-1 focus:ring-cyan focus:outline-none" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
                <button type="button" onclick="document.getElementById('upload-modal').classList.add('hidden')"
                        class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                    @L["Cancel"]
                </button>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-cyan px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan/90 transition-colors shadow-sm">
                    <i data-lucide="upload" class="w-4 h-4"></i>
                    @L["Upload Now"]
                </button>
            </div>
        </form>
    </div>
</div>

@* Usages & Delete Guard Modal *@
<div id="usages-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-foreground flex items-center gap-2">
                <i data-lucide="layers" class="w-5 h-5 text-cyan"></i>
                @L["Asset Usage & Reference Details"]
            </h3>
            <button type="button" onclick="closeUsagesModal()"
                    class="text-muted-foreground hover:text-foreground">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        @* Asset Info Card *@
        <div class="flex items-center gap-4 rounded-xl border border-border bg-background/50 p-3">
            <div class="w-14 h-14 rounded-lg bg-muted/40 overflow-hidden flex items-center justify-center shrink-0 border border-border">
                <img id="usages-asset-thumb" src="" alt="" class="w-full h-full object-cover hidden" />
                <i id="usages-asset-icon" data-lucide="file" class="w-6 h-6 text-muted-foreground"></i>
            </div>
            <div class="min-w-0 flex-1 space-y-1">
                <p id="usages-asset-name" class="text-xs font-semibold text-foreground truncate"></p>
                <p id="usages-asset-path" class="text-[11px] text-muted-foreground font-mono truncate"></p>
                <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                    <span id="usages-asset-category" class="inline-block rounded-md bg-muted px-2 py-0.5 font-medium"></span>
                    <span id="usages-asset-size"></span>
                </div>
            </div>
        </div>

        @* Loading State *@
        <div id="usages-loading" class="py-8 flex flex-col items-center justify-center gap-2 text-muted-foreground text-xs">
            <div class="w-6 h-6 border-2 border-cyan border-t-transparent rounded-full animate-spin"></div>
            <span>@L["Loading usage information..."]</span>
        </div>

        @* Error State *@
        <div id="usages-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-300">
            @L["Failed to load usage information."]
        </div>

        @* Unused State *@
        <div id="usages-empty" class="hidden space-y-4">
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-400 flex items-start gap-3">
                <i data-lucide="check-circle-2" class="w-5 h-5 shrink-0 text-emerald-400 mt-0.5"></i>
                <div class="space-y-1">
                    <h4 class="text-xs font-semibold text-emerald-300">@L["Unused — Safe to delete"]</h4>
                    <p class="text-[11px] text-emerald-400/80">@L["No content across the website currently references this asset."]</p>
                </div>
            </div>

            <form id="safe-delete-form" method="post" action="" class="pt-3 border-t border-border flex items-center justify-end gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                <button type="button" onclick="closeUsagesModal()"
                        class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                    @L["Cancel"]
                </button>
                <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-500 transition-colors shadow-sm">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    @L["Delete Asset"]
                </button>
            </form>
        </div>

        @* Referenced / In-Use State *@
        <div id="usages-in-use" class="hidden space-y-4">
            <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-amber-300 flex items-start gap-3">
                <i data-lucide="alert-triangle" class="w-5 h-5 shrink-0 text-amber-400 mt-0.5"></i>
                <div class="space-y-1">
                    <h4 id="usages-count-heading" class="text-xs font-semibold text-amber-200"></h4>
                    <p class="text-[11px] text-amber-300/80">@L["Deleting this asset will break references on the live website unless you replace the image in the referencing content first."]</p>
                </div>
            </div>

            <div class="rounded-xl border border-border overflow-hidden">
                <div class="bg-muted/40 px-3 py-2 border-b border-border text-[11px] font-semibold text-foreground flex items-center justify-between">
                    <span>@L["Referenced by the following content:"]</span>
                </div>
                <div class="divide-y divide-border/60 max-h-60 overflow-y-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-muted/20 text-[10px] text-muted-foreground uppercase font-semibold">
                            <tr>
                                <th class="px-3 py-2">@L["Location / Entity"]</th>
                                <th class="px-3 py-2">@L["Record Title"]</th>
                                <th class="px-3 py-2">@L["Property"]</th>
                                <th class="px-3 py-2 text-right">@L["Action"]</th>
                            </tr>
                        </thead>
                        <tbody id="usages-table-body" class="divide-y divide-border/40">
                        </tbody>
                    </table>
                </div>
            </div>

            @* Force Delete Guard *@
            <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                <label class="flex items-center gap-2.5 cursor-pointer text-xs text-foreground select-none">
                    <input type="checkbox" id="force-delete-checkbox" onchange="toggleForceDelete(this.checked)"
                           class="w-4 h-4 rounded border-border text-rose-600 focus:ring-rose-500" />
                    <span>@L["I understand the risks and want to force delete this asset."]</span>
                </label>

                <form id="force-delete-form" method="post" action="" class="pt-3 border-t border-rose-500/20 flex items-center justify-between gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="force" value="true" />
                    <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                    <button type="button" onclick="closeUsagesModal()"
                            class="rounded-xl border border-border px-4 py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
                        @L["Cancel"]
                    </button>
                    <button type="submit" id="force-delete-btn" disabled
                            class="inline-flex items-center gap-1.5 rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-500 transition-colors shadow-sm opacity-50 cursor-not-allowed">
                        <i data-lucide="alert-octagon" class="w-3.5 h-3.5"></i>
                        @L["Force Delete Asset"]
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    function copyAssetUrl(url) {
        navigator.clipboard.writeText(window.location.origin + url).then(() => {
            alert('Copied URL to clipboard: ' + url);
        });
    }

    function openUsagesFromButton(btn) {
        const id = btn.getAttribute('data-asset-id');
        const name = btn.getAttribute('data-asset-name');
        const path = btn.getAttribute('data-asset-path');
        const category = btn.getAttribute('data-asset-category');
        const size = btn.getAttribute('data-asset-size');
        openUsagesModal(id, name, path, category, size);
    }

    function openUsagesModal(id, name, path, category, size) {
        const modal = document.getElementById('usages-modal');
        const loading = document.getElementById('usages-loading');
        const error = document.getElementById('usages-error');
        const empty = document.getElementById('usages-empty');
        const inUse = document.getElementById('usages-in-use');

        document.getElementById('usages-asset-name').textContent = name;
        document.getElementById('usages-asset-path').textContent = path;
        document.getElementById('usages-asset-category').textContent = category || 'General';
        document.getElementById('usages-asset-size').textContent = size || '';

        const thumb = document.getElementById('usages-asset-thumb');
        const icon = document.getElementById('usages-asset-icon');
        if (path && (path.endsWith('.png') || path.endsWith('.jpg') || path.endsWith('.jpeg') || path.endsWith('.webp') || path.endsWith('.svg') || path.endsWith('.ico'))) {
            thumb.src = path;
            thumb.alt = name;
            thumb.classList.remove('hidden');
            icon.classList.add('hidden');
        } else {
            thumb.classList.add('hidden');
            icon.classList.remove('hidden');
        }

        const deleteUrl = '/cms/media/' + id + '/delete';
        document.getElementById('safe-delete-form').action = deleteUrl;
        document.getElementById('force-delete-form').action = deleteUrl;

        // Reset force delete checkbox
        const chk = document.getElementById('force-delete-checkbox');
        chk.checked = false;
        toggleForceDelete(false);

        // Show loading state
        loading.classList.remove('hidden');
        error.classList.add('hidden');
        empty.classList.add('hidden');
        inUse.classList.add('hidden');

        modal.classList.remove('hidden');
        if (window.lucide) {
            lucide.createIcons();
        }

        fetch('/cms/media/' + id + '/usages')
            .then(response => {
                if (!response.ok) throw new Error('Failed to fetch usages');
                return response.json();
            })
            .then(items => {
                loading.classList.add('hidden');
                if (!items || items.length === 0) {
                    empty.classList.remove('hidden');
                } else {
                    inUse.classList.remove('hidden');
                    const countHeading = document.getElementById('usages-count-heading');
                    countHeading.textContent = items.length === 1
                        ? '@L["Used in 1 place"]'
                        : '@L["Used in {0} places"]'.replace('{0}', items.length);

                    const tbody = document.getElementById('usages-table-body');
                    tbody.innerHTML = '';

                    items.forEach(u => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-muted/10 transition-colors';

                        const tdEntity = document.createElement('td');
                        tdEntity.className = 'px-3 py-2 font-medium';
                        tdEntity.innerHTML = `<span class="inline-flex items-center rounded-md bg-cyan/10 px-2 py-0.5 text-[10px] font-semibold text-cyan">${escapeHtml(u.entityType)}</span>`;

                        const tdLabel = document.createElement('td');
                        tdLabel.className = 'px-3 py-2 text-foreground font-medium';
                        tdLabel.textContent = u.entityLabel || '—';

                        const tdProp = document.createElement('td');
                        tdProp.className = 'px-3 py-2 text-muted-foreground font-mono text-[11px]';
                        tdProp.textContent = u.propertyName || '—';

                        const tdAction = document.createElement('td');
                        tdAction.className = 'px-3 py-2 text-right';
                        tdAction.innerHTML = `<a href="${escapeHtml(u.editUrl)}" class="inline-flex items-center gap-1 text-[11px] font-medium text-cyan hover:underline">@L["Edit"] <i data-lucide="external-link" class="w-3 h-3"></i></a>`;

                        tr.appendChild(tdEntity);
                        tr.appendChild(tdLabel);
                        tr.appendChild(tdProp);
                        tr.appendChild(tdAction);
                        tbody.appendChild(tr);
                    });

                    if (window.lucide) {
                        lucide.createIcons();
                    }
                }
            })
            .catch(err => {
                loading.classList.add('hidden');
                error.classList.remove('hidden');
                console.error(err);
            });
    }

    function toggleForceDelete(checked) {
        const btn = document.getElementById('force-delete-btn');
        btn.disabled = !checked;
        if (checked) {
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        } else {
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        }
    }

    function closeUsagesModal() {
        document.getElementById('usages-modal').classList.add('hidden');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
