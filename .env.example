# Copy to `.env` (git-ignored) and adjust. Every key is optional — docker-compose.yml
# already carries the same values as defaults, so the stack runs without this file.

# ── Host ports ──
NEURIX_WEB_PORT=18473
SQLSERVER_PORT=14330

# Hostname for the SSL proxy (without https:// or a path).
NEURIX_PROXY_DOMAIN=neurix.uk
# Set this to the reverse proxy's IP as seen by the web container when using HTTPS.
NEURIX_TRUSTED_PROXY_IP=

# ── SQL Server container ──
MSSQL_IMAGE_TAG=2022-latest
MSSQL_PID=Developer
# 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Neurix!Str0ngPassw0rd
# Database created and migrated by the app on first start-up.
DATABASE_NAME=Neurix

# ── Application ──
# Development => usable over plain HTTP. Use Production behind a TLS proxy.
ASPNETCORE_ENVIRONMENT=Development

# ── Seeded CRM/CMS administrator (created only when both are set) ──
SEED_ADMIN_EMAIL=admin@neurix.local
SEED_ADMIN_PASSWORD=Neurix@2026
SEED_ADMIN_FULLNAME=CRM Administrator
SEED_ADMIN_ALLOW_IN_PRODUCTION=false

# ── Optional: AI chat widget (text + voice). Leave empty to disable. ──
GEMINI_API_KEY=

TZ=Africa/Cairo
